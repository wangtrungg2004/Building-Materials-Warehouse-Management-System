<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BMWMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            margin: 0;
            background-color: #f8f9fa;
            font-family: 'Inter', sans-serif;
        }

        .app-shell {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* ----- SIDEBAR ----- */
        .sidebar {
            width: 260px;
            background-color: #141c2b;
            color: #94a3b8;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            box-shadow: 2px 0 10px rgba(0,0,0,0.1);
        }
        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 20px;
            text-decoration: none;
            border-bottom: 1px solid #1e293b;
        }
        .sidebar-brand-icon {
            background-color: #2563eb;
            color: white;
            width: 36px; height: 36px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 8px;
            font-size: 18px;
        }
        .sidebar-brand-text { color: #ffffff; font-weight: 700; font-size: 18px; line-height: 1.2; }
        .sidebar-brand-sub  { color: #cbd5e1; font-size: 11px; font-weight: 400; }
        .sidebar-menu {
            flex: 1;
            overflow-y: scroll;
            padding: 12px 0;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .sidebar-menu::-webkit-scrollbar { display: none; }
        .sidebar-section-label {
            font-size: 11px; font-weight: 600; color: #64748b;
            padding: 16px 20px 8px;
            text-transform: uppercase; letter-spacing: 0.5px;
        }
        .sidebar-nav { list-style: none; padding: 0; margin: 0; }
        .sidebar-nav > li { margin: 2px 12px; }
        .sidebar-nav > li > a {
            display: flex; align-items: center; justify-content: space-between;
            padding: 10px 12px;
            color: #cbd5e1; text-decoration: none;
            font-size: 14px; font-weight: 500;
            border-radius: 6px; transition: all 0.2s;
        }
        .sidebar-nav > li > a:hover           { color: #ffffff; background-color: rgba(255,255,255,0.05); }
        .sidebar-nav > li.active > a          { background-color: #1e3a8a; color: #ffffff; }
        .menu-title                           { display: flex; align-items: center; gap: 12px; }
        .menu-title i                         { font-size: 16px; width: 20px; text-align: center; }
        .sub-menu { list-style: none; padding: 0; margin: 0; position: relative; }
        .sub-menu::before {
            content: ''; position: absolute;
            left: 22px; top: 0; bottom: 20px;
            width: 1px; background-color: #334155;
        }
        .sub-menu li { position: relative; border-bottom: 1px solid rgba(51,65,85,0.5); }
        .sub-menu li:last-child { border-bottom: none; }
        .sub-menu a {
            display: flex; align-items: center;
            padding: 10px 10px 10px 24px;
            color: #94a3b8; text-decoration: none;
            font-size: 13px; font-weight: 500;
            transition: all 0.2s; border-radius: 6px;
        }
        .sub-menu li.active a { color: #ffffff; background-color: rgba(255,255,255,0.03); }
        .sub-menu a:hover     { color: #ffffff; background-color: rgba(255,255,255,0.03); }
        .sidebar-footer {
            padding: 16px 20px;
            border-top: 1px solid #1e293b;
            color: #cbd5e1; font-size: 14px; font-weight: 500;
            display: flex; align-items: center; gap: 12px;
            cursor: pointer; transition: color 0.2s;
        }
        .sidebar-footer:hover { color: #ffffff; }

        /* ----- MAIN AREA ----- */
        .main-area { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
        .topbar {
            background: #fff; height: 60px; padding: 0 24px;
            display: flex; align-items: center; justify-content: space-between;
            border-bottom: 1px solid #e2e8f0; flex-shrink: 0;
        }
        .breadcrumb { margin: 0; font-size: 13px; color: #64748b; }
        .topbar-right { display: flex; align-items: center; gap: 20px; }
        .icon-btn { position: relative; color: #475569; font-size: 18px; cursor: pointer; }
        .badge-notification {
            position: absolute; top: -5px; right: -5px;
            background: #ef4444; color: white;
            font-size: 10px; border-radius: 50%;
            padding: 2px 5px; font-weight: bold; border: 2px solid #fff;
        }
        .user-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
        .user-info { line-height: 1.2; }
        .user-name { font-size: 13px; font-weight: 600; color: #1e293b; }
        .user-role { font-size: 11px; color: #64748b; }
        .page-content { flex: 1; overflow-y: auto; padding: 24px; }
        .main-footer {
            padding: 15px 24px;
            display: flex; justify-content: space-between;
            font-size: 12px; color: #64748b;
            border-top: 1px solid #e2e8f0; background: #fff;
        }

        /* ----- USER DROPDOWN ----- */
        .user-dropdown-wrapper { position: relative; }
        .user-profile { display: flex; align-items: center; gap: 10px; cursor: pointer; user-select: none; }
        .user-dropdown-menu {
            display: none;
            position: absolute; top: calc(100% + 10px); right: 0;
            background: #fff; border: 1px solid #e2e8f0;
            border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            min-width: 200px; z-index: 9999; overflow: hidden;
        }
        .user-dropdown-menu.show { display: block; }
        .user-dropdown-menu a,
        .user-dropdown-menu button {
            display: flex; align-items: center; gap: 10px;
            padding: 11px 16px; font-size: 14px; color: #374151;
            text-decoration: none; background: none; border: none;
            width: 100%; text-align: left; cursor: pointer; transition: background 0.15s;
        }
        .user-dropdown-menu a:hover,
        .user-dropdown-menu button:hover { background: #f1f5f9; }
        .user-dropdown-menu .dropdown-divider { border-top: 1px solid #e2e8f0; margin: 4px 0; }
        .user-dropdown-menu .text-danger { color: #ef4444 !important; }

        /* ----- PROFILE MODALS ----- */
        .profile-modal .modal-dialog { max-width: 480px; }
        .profile-avatar-wrap { text-align: center; margin-bottom: 20px; }
        .profile-avatar-wrap img {
            width: 80px; height: 80px; border-radius: 50%;
            object-fit: cover; border: 3px solid #e2e8f0;
        }
        .profile-avatar-wrap .avatar-name { font-size: 18px; font-weight: 700; color: #1e293b; margin-top: 10px; }
        .profile-avatar-wrap .avatar-role { font-size: 13px; color: #64748b; }
        .profile-info-row {
            display: flex; align-items: center;
            padding: 11px 0; border-bottom: 1px solid #f1f5f9; font-size: 14px;
        }
        .profile-info-row:last-child { border-bottom: none; }
        .profile-info-row .pi-icon  { width: 32px; color: #64748b; font-size: 16px; flex-shrink: 0; }
        .profile-info-row .pi-label { width: 130px; color: #64748b; flex-shrink: 0; }
        .profile-info-row .pi-value { color: #1e293b; font-weight: 500; flex: 1; }
        .badge-status-active {
            background: #dcfce7; color: #16a34a;
            padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;
        }
        .badge-status-inactive {
            background: #fee2e2; color: #dc2626;
            padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;
        }
        .readonly-field { background: #f8fafc !important; color: #94a3b8 !important; }
        .form-label-required::after { content: ' *'; color: #ef4444; }
        .pw-toggle { cursor: pointer; color: #94a3b8; }
        .pw-toggle:hover { color: #374151; }
    </style>
</head>
<body>

    @{
        bool noShell = ViewData["NoShell"] as bool? ?? false;
    }

    @if (noShell)
    {
        @RenderBody()
    }
    else
    {
        <div class="app-shell">
            <aside class="sidebar">
                <a class="sidebar-brand" href="/">
                    <div class="sidebar-brand-icon"><i class="bi bi-building"></i></div>
                    <div>
                        <div class="sidebar-brand-text">BMWMS</div>
                        <div class="sidebar-brand-sub">Warehouse Management System</div>
                    </div>
                </a>

                <div class="sidebar-menu">
                    <ul class="sidebar-nav">
                        <li>
                            <a href="/Dashboard">
                                <div class="menu-title"><i class="bi bi-speedometer2"></i> Dashboard</div>
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-section-label">MASTER DATA</div>
                    <ul class="sidebar-nav">
                        <li class="active">
                            <a href="javascript:void(0)">
                                <div class="menu-title"><i class="bi bi-buildings"></i> Warehouse Management</div>
                                <i class="bi bi-chevron-up" style="font-size:12px;"></i>
                            </a>
                            <ul class="sub-menu">
                                <li class="active"><a href="/Warehouses">Warehouse List</a></li>
                                <li><a href="/Storage">Storage Location</a></li>
                            </ul>
                        </li>
                        <li>
                            <a href="javascript:void(0)" onclick="toggleSubMenu(this)">
                                <div class="menu-title"><i class="bi bi-box"></i> Product Management</div>
                                <i class="bi bi-chevron-down" style="font-size:12px;"></i>
                            </a>
                            <ul class="sub-menu" style="display:none;">
                                <li><a href="/ProductManagement/Products">Product List</a></li>
                                <li><a href="/ProductManagement/ProductGroups">Product Group</a></li>
                                <li><a href="/ProductManagement/ProductAttributes">Product Attributes</a></li>
                                <li><a href="#">Product Transaction History</a></li>
                            </ul>
                        </li>
                    </ul>

                    <div class="sidebar-section-label">OPERATIONS</div>
                    <ul class="sidebar-nav">
                        <li><a href="/Inbound"><div class="menu-title"><i class="bi bi-box-arrow-in-right"></i> Inbound</div><i class="bi bi-chevron-right" style="font-size:12px;"></i></a></li>
                        <li><a href="/Outbound"><div class="menu-title"><i class="bi bi-box-arrow-right"></i> Outbound</div><i class="bi bi-chevron-right" style="font-size:12px;"></i></a></li>
                        <li><a href="/Transfer"><div class="menu-title"><i class="bi bi-arrow-left-right"></i> Transfer</div><i class="bi bi-chevron-right" style="font-size:12px;"></i></a></li>
                        <li><a href="/Audit"><div class="menu-title"><i class="bi bi-clipboard-check"></i> Audit</div><i class="bi bi-chevron-right" style="font-size:12px;"></i></a></li>
                    </ul>

                    <div class="sidebar-section-label">REPORTS</div>
                    <ul class="sidebar-nav">
                        <li><a href="/Reports"><div class="menu-title"><i class="bi bi-file-earmark-bar-graph"></i> Reports</div><i class="bi bi-chevron-right" style="font-size:12px;"></i></a></li>
                        <li><a href="/Analytics"><div class="menu-title"><i class="bi bi-graph-up"></i> Analytics</div><i class="bi bi-chevron-right" style="font-size:12px;"></i></a></li>
                    </ul>

                    <div class="sidebar-section-label">SYSTEM</div>
                    <ul class="sidebar-nav">
                        <li><a href="/Users"><div class="menu-title"><i class="bi bi-people"></i> User Management</div><i class="bi bi-chevron-right" style="font-size:12px;"></i></a></li>
                        <li><a href="/Settings"><div class="menu-title"><i class="bi bi-gear"></i> System Settings</div><i class="bi bi-chevron-right" style="font-size:12px;"></i></a></li>
                    </ul>
                </div>

                <div class="sidebar-footer">
                    <i class="bi bi-chevron-left"></i> Collapse
                </div>
            </aside>

            <div class="main-area">
                <header class="topbar">
                    <div class="breadcrumb">
                        Warehouse Management <i class="bi bi-chevron-right mx-1" style="font-size:10px;"></i>
                        <span style="color:#1e293b;">Warehouses</span>
                    </div>
                    <div class="topbar-right">
                        <div class="icon-btn">
                            <i class="bi bi-bell"></i>
                            <span class="badge-notification">5</span>
                        </div>
                        <div class="icon-btn">
                            <i class="bi bi-question-circle"></i>
                        </div>
                        <div class="user-dropdown-wrapper">
                            <div class="user-profile d-flex align-items-center gap-2"
                                 id="userProfileBtn" onclick="toggleUserDropdown()">
                                <img id="topbarAvatar"
                                     src="https://ui-avatars.com/api/?name=User&background=2563eb&color=fff"
                                     class="user-avatar" alt="User">
                                <div class="user-info">
                                    <div class="user-name" id="topbarUserName">...</div>
                                    <div class="user-role" id="topbarUserRole">...</div>
                                </div>
                                <i class="bi bi-chevron-down ms-1" style="font-size:11px;color:#94a3b8;"></i>
                            </div>
                            <div class="user-dropdown-menu" id="userDropdownMenu">
                                <a href="javascript:void(0)" onclick="openViewProfile()">
                                    <i class="bi bi-person"></i> View Profile
                                </a>
                                <a href="javascript:void(0)" onclick="openChangePassword()">
                                    <i class="bi bi-lock"></i> Change Password
                                </a>
                                <div class="dropdown-divider"></div>
                                <button class="text-danger" onclick="doLogout()">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </div>
                        </div>
                    </div>
                </header>

                <div class="page-content">
                    @RenderBody()
                </div>

                <footer class="main-footer">
                    <div>© 2024 BMWMS. All rights reserved.</div>
                    <div>Version 1.0.0</div>
                </footer>
            </div>
        </div>
    }

    <!-- ===== MODAL: VIEW PROFILE ===== -->
    <div class="modal fade profile-modal" id="viewProfileModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">My Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4">
                    <div class="profile-avatar-wrap">
                        <img id="vpAvatar" src="" alt="avatar">
                        <div class="avatar-name" id="vpFullName">—</div>
                        <div class="avatar-role" id="vpRole">—</div>
                    </div>
                    <div class="profile-info-row">
                        <span class="pi-icon"><i class="bi bi-person-badge"></i></span>
                        <span class="pi-label">Employee ID</span>
                        <span class="pi-value" id="vpEmployeeId">—</span>
                    </div>
                    <div class="profile-info-row">
                        <span class="pi-icon"><i class="bi bi-person"></i></span>
                        <span class="pi-label">Username</span>
                        <span class="pi-value" id="vpUsername">—</span>
                    </div>
                    <div class="profile-info-row">
                        <span class="pi-icon"><i class="bi bi-envelope"></i></span>
                        <span class="pi-label">Email</span>
                        <span class="pi-value" id="vpEmail">—</span>
                    </div>
                    <div class="profile-info-row">
                        <span class="pi-icon"><i class="bi bi-telephone"></i></span>
                        <span class="pi-label">Phone Number</span>
                        <span class="pi-value" id="vpPhone">—</span>
                    </div>
                    <div class="profile-info-row">
                        <span class="pi-icon"><i class="bi bi-building"></i></span>
                        <span class="pi-label">Department</span>
                        <span class="pi-value" id="vpDepartment">—</span>
                    </div>
                    <div class="profile-info-row">
                        <span class="pi-icon"><i class="bi bi-calendar3"></i></span>
                        <span class="pi-label">Join Date</span>
                        <span class="pi-value" id="vpJoinDate">—</span>
                    </div>
                    <div class="profile-info-row">
                        <span class="pi-icon"><i class="bi bi-circle"></i></span>
                        <span class="pi-label">Status</span>
                        <span class="pi-value" id="vpStatus">—</span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 gap-2">
                    <button class="btn btn-outline-primary" onclick="openUpdateProfile()">
                        <i class="bi bi-pencil me-1"></i>Update Profile
                    </button>
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== MODAL: UPDATE PROFILE ===== -->
    <div class="modal fade profile-modal" id="updateProfileModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Update Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4">
                    <div class="profile-avatar-wrap mb-3">
                        <img id="upAvatar" src="" alt="avatar">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Employee ID</label>
                        <input type="text" class="form-control readonly-field" id="upEmployeeId" readonly>
                        <small class="text-muted">Read Only</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label form-label-required small fw-semibold">Full Name</label>
                        <input type="text" class="form-control" id="upFullName" placeholder="Enter full name">
                        <div class="text-danger small mt-1" id="upFullNameErr" style="display:none;"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label form-label-required small fw-semibold">Email</label>
                        <input type="email" class="form-control" id="upEmail" placeholder="Enter email">
                        <div class="text-danger small mt-1" id="upEmailErr" style="display:none;"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label form-label-required small fw-semibold">Phone Number</label>
                        <input type="text" class="form-control" id="upPhone" placeholder="Enter phone number">
                        <div class="text-danger small mt-1" id="upPhoneErr" style="display:none;"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Department</label>
                        <input type="text" class="form-control readonly-field" id="upDepartment" readonly>
                        <small class="text-muted">Read Only</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Role</label>
                        <input type="text" class="form-control readonly-field" id="upRole" readonly>
                        <small class="text-muted">Read Only</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Status</label>
                        <input type="text" class="form-control readonly-field" id="upStatus" readonly>
                        <small class="text-muted">Read Only</small>
                    </div>
                    <div id="upGlobalErr" class="alert alert-danger py-2" style="display:none;"></div>
                    <div id="upGlobalOk"  class="alert alert-success py-2" style="display:none;"></div>
                </div>
                <div class="modal-footer border-0 pt-0 gap-2">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" id="upSaveBtn" onclick="saveProfile()">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== MODAL: CHANGE PASSWORD ===== -->
    <div class="modal fade profile-modal" id="changePasswordModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Change Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4">
                    <p class="text-muted small mb-4">
                        For your security, please enter your current password and choose a new password.
                    </p>
                    <div class="mb-3">
                        <label class="form-label form-label-required small fw-semibold">Current Password</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="cpCurrent" placeholder="Enter current password">
                            <span class="input-group-text pw-toggle" onclick="togglePw('cpCurrent', this)">
                                <i class="bi bi-eye"></i>
                            </span>
                        </div>
                        <div class="text-danger small mt-1" id="cpCurrentErr" style="display:none;"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label form-label-required small fw-semibold">New Password</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="cpNew" placeholder="Enter new password">
                            <span class="input-group-text pw-toggle" onclick="togglePw('cpNew', this)">
                                <i class="bi bi-eye"></i>
                            </span>
                        </div>
                        <div class="text-muted small mt-1">
                            Password must be at least 8 characters and include uppercase, lowercase, number, and special character.
                        </div>
                        <div class="text-danger small mt-1" id="cpNewErr" style="display:none;"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label form-label-required small fw-semibold">Confirm New Password</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="cpConfirm" placeholder="Confirm new password">
                            <span class="input-group-text pw-toggle" onclick="togglePw('cpConfirm', this)">
                                <i class="bi bi-eye"></i>
                            </span>
                        </div>
                        <div class="text-danger small mt-1" id="cpConfirmErr" style="display:none;"></div>
                    </div>
                    <div id="cpGlobalErr" class="alert alert-danger py-2" style="display:none;"></div>
                    <div id="cpGlobalOk"  class="alert alert-success py-2" style="display:none;"></div>
                </div>
                <div class="modal-footer border-0 pt-0 gap-2">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" id="cpSaveBtn" onclick="doChangePassword()">
                        <i class="bi bi-shield-check me-1"></i>Update Password
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSubMenu(el) {
            var li = el.parentElement;
            var subMenu = li.querySelector('.sub-menu');
            var chevron = el.querySelector('[class*="bi-chevron"]');
            if (!subMenu) return;
            if (subMenu.style.display === 'none' || subMenu.style.display === '') {
                subMenu.style.display = 'block';
                if (chevron) { chevron.className = 'bi bi-chevron-up'; chevron.style.fontSize = '12px'; }
            } else {
                subMenu.style.display = 'none';
                if (chevron) { chevron.className = 'bi bi-chevron-right'; chevron.style.fontSize = '12px'; }
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
