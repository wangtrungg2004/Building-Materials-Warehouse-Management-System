<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BMWMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            margin: 0;
            background-color: #f8f9fa;
            font-family: 'Inter', sans-serif;
        }

        .app-shell {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* ----- SIDEBAR STYLES ----- */
        .sidebar {
            width: 260px;
            background-color: #141c2b;
            color: #94a3b8;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            box-shadow: 2px 0 10px rgba(0,0,0,0.1);
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 20px;
            text-decoration: none;
            border-bottom: 1px solid #1e293b;
        }

        .sidebar-brand-icon {
            background-color: #2563eb;
            color: white;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            font-size: 18px;
        }

        .sidebar-brand-text {
            color: #ffffff;
            font-weight: 700;
            font-size: 18px;
            line-height: 1.2;
        }

        .sidebar-brand-sub {
            color: #cbd5e1;
            font-size: 11px;
            font-weight: 400;
        }

        .sidebar-menu {
            flex: 1;
            overflow-y: auto;
            padding: 12px 0;
        }

        .sidebar-section-label {
            font-size: 11px;
            font-weight: 600;
            color: #64748b;
            padding: 16px 20px 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .sidebar-nav > li {
                margin: 2px 12px;
            }

                .sidebar-nav > li > a {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 10px 12px;
                    color: #cbd5e1;
                    text-decoration: none;
                    font-size: 14px;
                    font-weight: 500;
                    border-radius: 6px;
                    transition: all 0.2s;
                }

                    .sidebar-nav > li > a:hover {
                        color: #ffffff;
                        background-color: rgba(255, 255, 255, 0.05);
                    }

                .sidebar-nav > li.active > a {
                    background-color: #1e3a8a;
                    color: #ffffff;
                }

        .menu-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .menu-title i {
                font-size: 16px;
                width: 20px;
                text-align: center;
            }

        /* Sub-menu (Tree view) */
        .sub-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            position: relative;
        }

            .sub-menu::before {
                content: '';
                position: absolute;
                left: 22px;
                top: 0;
                bottom: 20px;
                width: 1px;
                background-color: #334155;
            }

            .sub-menu li {
                position: relative;
            }

            .sub-menu a {
                display: flex;
                align-items: center;
                padding: 10px 10px 10px 48px;
                color: #94a3b8;
                text-decoration: none;
                font-size: 13px;
                font-weight: 500;
                transition: all 0.2s;
                border-radius: 6px;
            }

                .sub-menu a:hover {
                    color: #ffffff;
                }

                .sub-menu a::before {
                    content: '';
                    position: absolute;
                    left: 19px;
                    width: 7px;
                    height: 7px;
                    border-radius: 50%;
                    background-color: #475569;
                    z-index: 2;
                }

            .sub-menu li.active a {
                color: #ffffff;
                background-color: rgba(255, 255, 255, 0.03);
            }

                .sub-menu li.active a::before {
                    background-color: #3b82f6;
                    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
                }

        .sidebar-footer {
            padding: 16px 20px;
            border-top: 1px solid #1e293b;
            color: #cbd5e1;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: color 0.2s;
        }

            .sidebar-footer:hover {
                color: #ffffff;
            }

        /* ----- MAIN AREA STYLES ----- */
        .main-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .topbar {
            background: #fff;
            height: 60px;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e2e8f0;
            flex-shrink: 0;
        }

        .breadcrumb {
            margin: 0;
            font-size: 13px;
            color: #64748b;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .icon-btn {
            position: relative;
            color: #475569;
            font-size: 18px;
            cursor: pointer;
        }

        .badge-notification {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #ef4444;
            color: white;
            font-size: 10px;
            border-radius: 50%;
            padding: 2px 5px;
            font-weight: bold;
            border: 2px solid #fff;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
        }

        .user-info {
            line-height: 1.2;
        }

        .user-name {
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
        }

        .user-role {
            font-size: 11px;
            color: #64748b;
        }

        .page-content {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
        }

        .main-footer {
            padding: 15px 24px;
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #64748b;
            border-top: 1px solid #e2e8f0;
            background: #fff;
        }
    </style>
</head>
<body>

    @{
        bool noShell = ViewData["NoShell"] as bool? ?? false;
    }

    @if (noShell)
    {
        @* SỬA LỖI Ở ĐÂY: Dành cho trang không dùng sidebar (như Login) *@
        @RenderBody()
    }
    else
    {
        <div class="app-shell">
            <aside class="sidebar">
                <a class="sidebar-brand" href="/">
                    <div class="sidebar-brand-icon">
                        <i class="bi bi-building"></i>
                    </div>
                    <div>
                        <div class="sidebar-brand-text">BMWMS</div>
                        <div class="sidebar-brand-sub">Warehouse Management System</div>
                    </div>
                </a>

                <div class="sidebar-menu">
                    <ul class="sidebar-nav">
                        <li>
                            <a href="/Dashboard">
                                <div class="menu-title"><i class="bi bi-speedometer2"></i> Dashboard</div>
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-section-label">MASTER DATA</div>
                    <ul class="sidebar-nav">
                        <li class="active">
                            <a href="javascript:void(0)">
                                <div class="menu-title"><i class="bi bi-buildings"></i> Warehouse Management</div>
                                <i class="bi bi-chevron-up" style="font-size: 12px;"></i>
                            </a>
                            <ul class="sub-menu">
                                <li class="active"><a href="/Warehouses">Warehouse List</a></li>
                                <li><a href="/Storage">Storage Location</a></li>
                            </ul>
                        </li>
                        <li>
                            <a href="javascript:void(0)">
                                <div class="menu-title"><i class="bi bi-box"></i> Product Management</div>
                                <i class="bi bi-chevron-right" style="font-size: 12px;"></i>
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-section-label">OPERATIONS</div>
                    <ul class="sidebar-nav">
                        <li><a href="/Inbound"><div class="menu-title"><i class="bi bi-box-arrow-in-right"></i> Inbound</div><i class="bi bi-chevron-right" style="font-size: 12px;"></i></a></li>
                        <li><a href="/Outbound"><div class="menu-title"><i class="bi bi-box-arrow-right"></i> Outbound</div><i class="bi bi-chevron-right" style="font-size: 12px;"></i></a></li>
                        <li><a href="/Transfer"><div class="menu-title"><i class="bi bi-arrow-left-right"></i> Transfer</div><i class="bi bi-chevron-right" style="font-size: 12px;"></i></a></li>
                        <li><a href="/Audit"><div class="menu-title"><i class="bi bi-clipboard-check"></i> Audit</div><i class="bi bi-chevron-right" style="font-size: 12px;"></i></a></li>
                    </ul>

                    <div class="sidebar-section-label">REPORTS</div>
                    <ul class="sidebar-nav">
                        <li><a href="/Reports"><div class="menu-title"><i class="bi bi-file-earmark-bar-graph"></i> Reports</div><i class="bi bi-chevron-right" style="font-size: 12px;"></i></a></li>
                        <li><a href="/Analytics"><div class="menu-title"><i class="bi bi-graph-up"></i> Analytics</div><i class="bi bi-chevron-right" style="font-size: 12px;"></i></a></li>
                    </ul>

                    <div class="sidebar-section-label">SYSTEM</div>
                    <ul class="sidebar-nav">
                        <li><a href="/Users"><div class="menu-title"><i class="bi bi-people"></i> User Management</div><i class="bi bi-chevron-right" style="font-size: 12px;"></i></a></li>
                        <li><a href="/Settings"><div class="menu-title"><i class="bi bi-gear"></i> System Settings</div><i class="bi bi-chevron-right" style="font-size: 12px;"></i></a></li>
                    </ul>
                </div>

                <div class="sidebar-footer">
                    <i class="bi bi-chevron-left"></i> Collapse
                </div>
            </aside>

            <div class="main-area">
                <header class="topbar">
                    <div class="breadcrumb">
                        Warehouse Management <i class="bi bi-chevron-right mx-1" style="font-size: 10px;"></i> <span style="color:#1e293b;">Warehouses</span>
                    </div>
                    <div class="topbar-right">
                        <div class="icon-btn">
                            <i class="bi bi-bell"></i>
                            <span class="badge-notification">5</span>
                        </div>
                        <div class="icon-btn">
                            <i class="bi bi-question-circle"></i>
                        </div>
                        <div class="user-profile">
                            <img src="https://ui-avatars.com/api/?name=Nguyen+Van+A&background=random" class="user-avatar" alt="User">
                            <div class="user-info">
                                <div class="user-name">Nguyen Van A</div>
                                <div class="user-role">Warehouse Manager</div>
                            </div>
                        </div>
                    </div>
                </header>

                <div class="page-content">
                    @* SỬA LỖI Ở ĐÂY: Hàm RenderBody bắt buộc phải có để hiển thị nội dung trang con *@
                    @RenderBody()
                </div>

                <footer class="main-footer">
                    <div>© 2024 BMWMS. All rights reserved.</div>
                    <div>Version 1.0.0</div>
                </footer>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>