@page
@model BmWms.Web.Pages.DashboardModel
@{
    ViewData["Title"]    = "Dashboard";
    ViewData["Subtitle"] = "Tổng quan hoạt động kho hôm nay";
    ViewData["ActivePage"] = "Dashboard";
}

<!-- Stat cards (dữ liệu sẽ được điền bằng JS sau khi load) -->
<div class="stat-grid" id="stat-grid">
    <div class="stat-card">
        <div class="stat-label">Tổng vật tư</div>
        <div class="stat-value" id="stat-products">—</div>
        <div class="stat-trend" id="stat-products-sub">đang tải...</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Nhập hôm nay</div>
        <div class="stat-value" id="stat-inbound">—</div>
        <div class="stat-trend">phiếu nhập</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Xuất hôm nay</div>
        <div class="stat-value" id="stat-outbound">—</div>
        <div class="stat-trend">phiếu xuất</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Cảnh báo tồn kho</div>
        <div class="stat-value" id="stat-alerts" style="color:var(--color-danger);">—</div>
        <div class="stat-trend down" id="stat-alerts-sub">vật tư dưới ngưỡng tối thiểu</div>
    </div>
</div>

<!-- Quick actions -->
<div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap;">
    <a href="/Inbound/Create" class="btn-wms-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tạo phiếu nhập
    </a>
    <a href="/Outbound/Create" class="btn-wms-secondary">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tạo phiếu xuất
    </a>
    <a href="/Inventory" class="btn-wms-secondary">
        Xem tồn kho
    </a>
</div>

<!-- Recent activity placeholder -->
<div class="wms-card" style="margin-top:24px;">
    <div class="wms-card-header">
        <h2 class="wms-card-title">Hoạt động gần đây</h2>
    </div>
    <div class="wms-card-body" id="recent-activity">
        <div style="text-align:center;padding:32px;color:var(--color-text-muted);">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16" style="margin-bottom:8px;opacity:.4"><path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/></svg>
            <div>Chưa có hoạt động nào được ghi nhận hôm nay.</div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Dashboard chỉ cần requireAuth() (đã gọi global trong site.js)
// Phần này sẽ gọi API để lấy số liệu thực khi các module khác được xây dựng.

// Placeholder: điền số 0 sau timeout giả lập
setTimeout(() => {
    document.getElementById('stat-products').textContent     = '—';
    document.getElementById('stat-products-sub').textContent = 'chưa có dữ liệu';
    document.getElementById('stat-inbound').textContent      = '0';
    document.getElementById('stat-outbound').textContent     = '0';
    document.getElementById('stat-alerts').textContent       = '0';
}, 300);
</script>
}
