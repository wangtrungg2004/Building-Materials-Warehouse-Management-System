@page
@model BmWms.Web.Pages.ProductManagement.ProductDetailModel
@{
    ViewData["Title"] = "Product Detail";
    ViewData["ActivePage"] = "Products";
}

<div style="margin-bottom:16px;">
    <a href="/ProductManagement/Products" style="color:var(--color-accent);text-decoration:none;font-size:14px;font-weight:500;">
        <i class="bi bi-arrow-left"></i> Back to Product List
    </a>
</div>

<div id="product-detail-container">
    <div style="text-align:center;padding:60px;color:var(--color-text-muted);">
        <i class="bi bi-arrow-clockwise" style="font-size:32px;animation:spin 1s linear infinite;"></i>
        <div style="margin-top:12px;">Loading product details...</div>
    </div>
</div>

<!-- Add Attribute Modal -->
<div id="attr-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1001;align-items:center;justify-content:center;">
    <div style="background:white;border-radius:16px;width:700px;max-width:95vw;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 25px 80px rgba(0,0,0,0.25);animation:modalSlideIn 0.25s ease;">
        <div style="padding:20px 24px;border-bottom:1px solid var(--color-border);display:flex;justify-content:space-between;align-items:center;">
            <div>
                <h3 style="margin:0;font-size:18px;font-weight:700;">Select Attributes</h3>
                <p style="margin:4px 0 0;font-size:13px;color:var(--color-text-muted);">Choose attribute values for this product</p>
            </div>
            <button onclick="closeAttrModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--color-text-muted);padding:8px;border-radius:8px;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        
        <!-- Search -->
        <div style="padding:16px 24px;border-bottom:1px solid var(--color-border);background:#fafbfc;">
            <div style="display:flex;gap:12px;">
                <div style="position:relative;flex:1;">
                    <input type="text" id="attr-search" class="wms-input" placeholder="Search attributes or values..." style="padding-right:36px;">
                    <i class="bi bi-search" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--color-text-muted);"></i>
                </div>
                <select id="attr-filter-status" class="wms-input" style="width:140px;">
                    <option value="">All</option>
                    <option value="selected">Selected</option>
                    <option value="available">Available</option>
                </select>
            </div>
        </div>
        
        <!-- Selection List -->
        <div id="attr-selection-list" style="flex:1;overflow-y:auto;padding:16px 24px;">
            <!-- Attribute groups will be rendered here -->
        </div>
        
        <!-- Pagination -->
        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 24px;border-top:1px solid var(--color-border);background:#fafbfc;">
            <div id="attr-pagination-info" style="font-size:13px;color:var(--color-text-muted);"></div>
            <div style="display:flex;gap:8px;align-items:center;">
                <div id="attr-pagination" style="display:flex;gap:4px;"></div>
            </div>
        </div>
        
        <!-- Footer -->
        <div style="padding:16px 24px;border-top:1px solid var(--color-border);display:flex;justify-content:flex-end;gap:12px;background:#fafbfc;border-radius:0 0 16px 16px;">
            <button onclick="closeAttrModal()" class="btn-wms-secondary">Cancel</button>
            <button onclick="saveSelections()" class="btn-wms-primary">
                <i class="bi bi-check-lg"></i> Save Selection
            </button>
        </div>
    </div>
</div>

<div id="toast-container"></div>

@section Scripts {
<script>
    const productId = new URLSearchParams(window.location.search).get('id');
    let availableAttributes = [];
    let currentSelections = [];
    let selectedValues = new Set();
    let attrModalPage = 1;
    let attrModalPageSize = 10;

    async function loadProduct() {
        if (!productId) {
            document.getElementById('product-detail-container').innerHTML =
                '<div class="wms-card"><div class="wms-card-body" style="text-align:center;padding:40px;color:var(--color-danger);">Product ID is required.</div></div>';
            return;
        }

        try {
            const res = await apiFetch(`/api/product/${productId}`);
            if (!res.ok) {
                document.getElementById('product-detail-container').innerHTML =
                    '<div class="wms-card"><div class="wms-card-body" style="text-align:center;padding:40px;color:var(--color-danger);">Product not found.</div></div>';
                return;
            }

            const p = await res.json();
            renderDetail(p);
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
        }
    }

    function renderDetail(p) {
        const container = document.getElementById('product-detail-container');
        container.innerHTML = `
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
                <div style="display:flex;align-items:center;gap:16px;">
                    <h1 style="font-size:24px;font-weight:800;margin:0;">${escHtml(p.productName)}</h1>
                    <span class="${p.isActive ? 'badge-active' : 'badge-inactive'}" style="font-size:13px;padding:4px 12px;">● ${p.isActive ? 'Active' : 'Inactive'}</span>
                </div>
                <div style="display:flex;gap:10px;">
                    <a href="/ProductManagement/ProductEdit?id=${p.productID}" class="btn-wms-secondary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <button class="btn-wms-secondary" onclick="toggleStatus(${p.productID}, ${p.isActive})"
                        style="${p.isActive ? 'color:var(--color-danger);border-color:#fecaca;' : 'color:var(--color-success);border-color:#bbf7d0;'}">
                        <i class="bi bi-${p.isActive ? 'x-circle' : 'check-circle'}"></i> ${p.isActive ? 'Deactivate' : 'Activate'}
                    </button>
                </div>
            </div>

            <div class="wms-card" style="margin-bottom:20px;">
                <div class="wms-card-body" style="display:flex;gap:32px;align-items:flex-start;">
                    <div style="flex-shrink:0;">
                        ${p.imageUrl
                            ? `<img src="${p.imageUrl}" style="width:240px;height:240px;border-radius:12px;object-fit:cover;border:1px solid var(--color-border);">`
                            : `<div style="width:240px;height:240px;border-radius:12px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;border:1px solid var(--color-border);">
                                <i class="bi bi-box" style="font-size:48px;color:var(--color-text-muted);opacity:0.5;"></i>
                               </div>`
                        }
                    </div>
                    <div style="flex:1;">
                        <table style="width:100%;font-size:14px;">
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);width:160px;font-weight:500;">Product Code</td>
                                <td style="padding:14px 0;font-weight:600;">${escHtml(p.productCode)}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Product Name</td>
                                <td style="padding:14px 0;">${escHtml(p.productName)}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Product Group</td>
                                <td style="padding:14px 0;">${escHtml(p.productGroupName || '—')}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Unit of Measure</td>
                                <td style="padding:14px 0;">${escHtml(p.unitOfMeasure || '—')}</td>
                            </tr>
                            <tr>
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Status</td>
                                <td style="padding:14px 0;white-space:nowrap;"><span class="${p.isActive ? 'badge-active' : 'badge-inactive'}">● ${p.isActive ? 'Active' : 'Inactive'}</span></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <div class="wms-card">
                <div style="border-bottom:1px solid var(--color-border);padding:0 20px;">
                    <div style="display:flex;gap:0;">
                        <button class="detail-tab active" onclick="switchTab(this, 'tab-basic')">Basic</button>
                        <button class="detail-tab" onclick="switchTab(this, 'tab-additional')">Additional</button>
                        <button class="detail-tab" onclick="switchTab(this, 'tab-attributes')">Attributes</button>
                    </div>
                </div>

                <div id="tab-basic" class="tab-content" style="display:block;">
                    <div class="wms-card-body">
                        <table style="width:100%;font-size:14px;max-width:700px;">
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);width:180px;font-weight:500;">Description</td>
                                <td style="padding:14px 0;">${escHtml(p.description || '—')}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Barcode</td>
                                <td style="padding:14px 0;">${escHtml(p.barcode || '—')}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Brand</td>
                                <td style="padding:14px 0;">${escHtml(p.brand || '—')}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Origin Country</td>
                                <td style="padding:14px 0;">${escHtml(p.originCountry || '—')}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">SKU</td>
                                <td style="padding:14px 0;">${escHtml(p.sku || '—')}</td>
                            </tr>
                            <tr>
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Min Threshold</td>
                                <td style="padding:14px 0;">${p.minThreshold}</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div id="tab-additional" class="tab-content" style="display:none;">
                    <div class="wms-card-body">
                        <table style="width:100%;font-size:14px;max-width:700px;">
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);width:180px;font-weight:500;">Weight</td>
                                <td style="padding:14px 0;">${p.weight ? p.weight + ' kg' : '—'}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Dimensions</td>
                                <td style="padding:14px 0;">${p.dimensionLength ? `${p.dimensionLength} x ${p.dimensionWidth || 0} x ${p.dimensionHeight || 0} cm` : '—'}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Shelf Life</td>
                                <td style="padding:14px 0;">${p.shelfLife ? p.shelfLife + ' days' : '—'}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Warranty Period</td>
                                <td style="padding:14px 0;">${p.warrantyPeriod ? p.warrantyPeriod + ' months' : '—'}</td>
                            </tr>
                            <tr style="border-bottom:1px solid var(--color-border);">
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Tags</td>
                                <td style="padding:14px 0;">
                                    ${p.tags ? p.tags.split(',').map(t => `<span class="badge-role" style="margin-right:4px;">${escHtml(t.trim())}</span>`).join('') : '—'}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:14px 0;color:var(--color-text-muted);font-weight:500;">Created</td>
                                <td style="padding:14px 0;">${formatDate(p.createdAt)} ${p.createdBy ? 'by ' + escHtml(p.createdBy) : ''}</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div id="tab-attributes" class="tab-content" style="display:none;">
                    <div class="wms-card-body" style="padding:24px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
                            <div>
                                <h3 style="margin:0 0 4px;font-size:16px;font-weight:600;">Product Attributes</h3>
                                <p style="margin:0;font-size:13px;color:var(--color-text-muted);">View and manage attribute values for this product</p>
                            </div>
                            <div style="display:flex;gap:10px;">
                                <a href="/ProductManagement/ProductAttributes" class="btn-wms-secondary" style="padding:6px 12px;font-size:12px;">
                                    <i class="bi bi-gear"></i> Manage Attributes
                                </a>
                                <button onclick="openAttrModal()" class="btn-wms-primary" style="padding:6px 12px;font-size:12px;">
                                    <i class="bi bi-plus-lg"></i> Add Attribute
                                </button>
                            </div>
                        </div>
                        <div id="attributes-display">
                            <div style="text-align:center;padding:40px;color:var(--color-text-muted);">
                                <i class="bi bi-arrow-clockwise" style="font-size:24px;animation:spin 1s linear infinite;"></i>
                                <div style="margin-top:8px;">Loading attributes...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

    function switchTab(btn, tabId) {
        document.querySelectorAll('.detail-tab').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
        btn.classList.add('active');
        document.getElementById(tabId).style.display = 'block';
        
        if (tabId === 'tab-attributes') {
            loadProductAttributes();
        }
    }

    async function loadProductAttributes() {
        const display = document.getElementById('attributes-display');
        if (!display) return;

        try {
            const [selectionsRes, attrsRes] = await Promise.all([
                apiFetch(`/api/productattributeselection/product/${productId}`),
                apiFetch('/api/productattribute/active')
            ]);
            
            currentSelections = await selectionsRes.json();
            availableAttributes = await attrsRes.json();
            
            renderAttributesDisplay();
        } catch (err) {
            display.innerHTML = `<div style="color:var(--color-danger);padding:20px;">Lỗi tải thuộc tính: ${err.message}</div>`;
        }
    }

    function renderAttributesDisplay() {
        const display = document.getElementById('attributes-display');
        
        if (!availableAttributes || availableAttributes.length === 0) {
            display.innerHTML = `
                <div style="text-align:center;padding:40px;color:var(--color-text-muted);">
                    <i class="bi bi-info-circle" style="font-size:32px;margin-bottom:12px;"></i>
                    <div style="font-size:14px;">No attributes defined yet.</div>
                    <a href="/ProductManagement/ProductAttributes" class="btn-wms-primary" style="margin-top:16px;display:inline-flex;">
                        <i class="bi bi-plus-lg"></i> Create Attributes
                    </a>
                </div>
            `;
            return;
        }

        // Group selections by attribute
        const groupedSelections = {};
        currentSelections.forEach(sel => {
            const attrId = sel.attributeID;
            if (!groupedSelections[attrId]) {
                groupedSelections[attrId] = [];
            }
            groupedSelections[attrId].push(sel);
        });

        // Filter to only show attributes that have selections
        const hasSelections = availableAttributes.filter(attr => 
            groupedSelections[attr.attributeID] && groupedSelections[attr.attributeID].length > 0
        );

        if (hasSelections.length === 0) {
            display.innerHTML = `
                <div style="text-align:center;padding:40px;color:var(--color-text-muted);">
                    <i class="bi bi-tags" style="font-size:32px;margin-bottom:12px;"></i>
                    <div style="font-size:14px;">This product has no attributes selected.</div>
                    <button onclick="openAttrModal()" class="btn-wms-primary" style="margin-top:16px;">
                        <i class="bi bi-plus-lg"></i> Add Attributes
                    </button>
                </div>
            `;
            return;
        }

        let html = `
            <table style="width:100%;border-collapse:collapse;font-size:14px;">
                <thead>
                    <tr style="border-bottom:2px solid var(--color-border);">
                        <th style="text-align:left;padding:12px 16px;font-weight:600;color:var(--color-text-primary);width:180px;">Attribute</th>
                        <th style="text-align:left;padding:12px 16px;font-weight:600;color:var(--color-text-primary);">Values</th>
                    </tr>
                </thead>
                <tbody>
        `;

        hasSelections.forEach(attr => {
            const values = groupedSelections[attr.attributeID] || [];
            html += `
                <tr style="border-bottom:1px solid var(--color-border);">
                    <td style="padding:14px 16px;font-weight:500;color:var(--color-text-primary);">${escHtml(attr.attributeName)}</td>
                    <td style="padding:14px 16px;">
                        <div style="display:flex;flex-wrap:wrap;gap:6px;">
                            ${values.map((selVal, idx) => `
                                <span style="display:inline-flex;align-items:center;gap:4px;padding:4px 10px;background:#e2e8f0;color:#475569;border-radius:6px;font-size:12px;">
                                    ${escHtml(selVal.valueName)}
                                    <button onclick="removeSelection(${selVal.selectionID})" style="background:none;border:none;cursor:pointer;font-size:14px;opacity:0.6;line-height:1;color:#dc2626;padding:0 2px;">×</button>
                                </span>
                            `).join('')}
                        </div>
                    </td>
                </tr>
            `;
        });

        html += `
                </tbody>
            </table>
        `;
        display.innerHTML = html;
    }

    function openAttrModal() {
        selectedValues = new Set(currentSelections.map(s => s.valueID));
        attrModalPage = 1;
        renderAttrSelectionList();
        document.getElementById('attr-modal').style.display = 'flex';
    }

    function closeAttrModal() {
        document.getElementById('attr-modal').style.display = 'none';
    }

    function renderAttrSelectionList() {
        const container = document.getElementById('attr-selection-list');
        const search = document.getElementById('attr-search').value.toLowerCase();
        const filter = document.getElementById('attr-filter-status').value;
        
        // Flatten all values with attribute info
        let allValues = [];
        availableAttributes.forEach(attr => {
            (attr.values || []).forEach(v => {
                allValues.push({
                    ...v,
                    attributeID: attr.attributeID,
                    attributeName: attr.attributeName
                });
            });
        });

        // Filter
        if (filter === 'selected') {
            allValues = allValues.filter(v => selectedValues.has(v.valueID));
        } else if (filter === 'available') {
            allValues = allValues.filter(v => !selectedValues.has(v.valueID));
        }
        
        if (search) {
            allValues = allValues.filter(v => 
                v.valueName.toLowerCase().includes(search) || 
                v.attributeName.toLowerCase().includes(search) ||
                (v.valueCode || '').toLowerCase().includes(search)
            );
        }

        // Paginate
        const totalCount = allValues.length;
        const totalPages = Math.ceil(totalCount / attrModalPageSize);
        const startIdx = (attrModalPage - 1) * attrModalPageSize;
        const pageItems = allValues.slice(startIdx, startIdx + attrModalPageSize);

        if (allValues.length === 0) {
            container.innerHTML = `
                <div style="text-align:center;padding:40px;color:var(--color-text-muted);">
                    <i class="bi bi-search" style="font-size:32px;margin-bottom:12px;"></i>
                    <div>No matching values found.</div>
                </div>
            `;
        } else {
            // Group by attribute
            const grouped = {};
            pageItems.forEach(v => {
                if (!grouped[v.attributeID]) {
                    grouped[v.attributeID] = { name: v.attributeName, values: [] };
                }
                grouped[v.attributeID].values.push(v);
            });

            let html = '';
            Object.entries(grouped).forEach(([attrId, group]) => {
                html += `
                    <div style="margin-bottom:20px;">
                        <div style="font-weight:600;font-size:14px;color:var(--color-text-primary);margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--color-border);">
                            ${escHtml(group.name)}
                        </div>
                        <div style="display:flex;flex-wrap:wrap;gap:8px;">
                            ${group.values.map(v => {
                                const isSelected = selectedValues.has(v.valueID);
                                return `
                                    <button onclick="toggleValueSelection(${v.valueID})" 
                                        style="display:inline-flex;align-items:center;gap:4px;padding:6px 12px;border-radius:6px;font-size:12px;cursor:pointer;border:1px solid var(--color-border);transition:all 0.15s;${isSelected ? 'background:var(--color-accent);color:white;border-color:var(--color-accent);' : 'background:#f1f5f9;'}">
                                        ${isSelected ? '<i class="bi bi-check" style="font-size:10px;"></i>' : ''}
                                        ${escHtml(v.valueName)}
                                    </button>
                                `;
                            }).join('')}
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        // Pagination
        document.getElementById('attr-pagination-info').textContent = `Showing ${startIdx + 1}-${Math.min(startIdx + pageItems.length, totalCount)} of ${totalCount}`;
        renderAttrPagination(attrModalPage, totalPages);
    }

    function renderAttrPagination(page, totalPages) {
        const container = document.getElementById('attr-pagination');
        if (totalPages <= 1) { container.innerHTML = ''; return; }

        let html = `<button class="btn-page ${page <= 1 ? 'disabled' : ''}" onclick="goToAttrPage(${page - 1})" ${page <= 1 ? 'disabled' : ''}>&lt;</button>`;

        const maxVisible = 5;
        let start = Math.max(1, page - 2);
        let end = Math.min(totalPages, start + maxVisible - 1);
        if (end - start < maxVisible - 1) start = Math.max(1, end - maxVisible + 1);

        if (start > 1) html += `<button class="btn-page" onclick="goToAttrPage(1)">1</button><span style="padding:0 4px;">...</span>`;

        for (let i = start; i <= end; i++) {
            html += `<button class="btn-page ${i === page ? 'active' : ''}" onclick="goToAttrPage(${i})">${i}</button>`;
        }

        if (end < totalPages) html += `<span style="padding:0 4px;">...</span><button class="btn-page" onclick="goToAttrPage(${totalPages})">${totalPages}</button>`;

        html += `<button class="btn-page ${page >= totalPages ? 'disabled' : ''}" onclick="goToAttrPage(${page + 1})" ${page >= totalPages ? 'disabled' : ''}>&gt;</button>`;
        container.innerHTML = html;
    }

    function goToAttrPage(p) { attrModalPage = p; renderAttrSelectionList(); }

    function toggleValueSelection(valueId) {
        if (selectedValues.has(valueId)) {
            selectedValues.delete(valueId);
        } else {
            selectedValues.add(valueId);
        }
        renderAttrSelectionList();
    }

    async function saveSelections() {
        const valueIds = Array.from(selectedValues);
        
        try {
            const res = await apiFetch(`/api/productattributeselection/product/${productId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ valueIDs: valueIds })
            });

            if (res.ok) {
                showToast('Cập nhật thuộc tính thành công!', 'success');
                closeAttrModal();
                loadProductAttributes();
            } else {
                const data = await res.json();
                showToast(data.message || 'Lỗi lưu thuộc tính.', 'error');
            }
        } catch (err) {
            showToast('Lỗi: ' + err.message, 'error');
        }
    }

    async function removeSelection(selectionId) {
        try {
            const res = await apiFetch(`/api/productattributeselection/${selectionId}`, {
                method: 'DELETE'
            });

            if (res.ok) {
                showToast('Đã xóa giá trị thuộc tính.', 'success');
                loadProductAttributes();
            } else {
                const data = await res.json();
                showToast(data.message || 'Lỗi xóa.', 'error');
            }
        } catch (err) {
            showToast('Lỗi: ' + err.message, 'error');
        }
    }

    async function toggleStatus(id, currentActive) {
        try {
            const res = await apiFetch(`/api/product/${id}`);
            const p = await res.json();

            const updateRes = await apiFetch(`/api/product/${id}`, {
                method: 'PUT',
                body: JSON.stringify({
                    productCode: p.productCode,
                    productName: p.productName,
                    productGroupID: p.productGroupID,
                    unitOfMeasure: p.unitOfMeasure,
                    sku: p.sku,
                    barcode: p.barcode,
                    brand: p.brand,
                    originCountry: p.originCountry,
                    description: p.description,
                    weight: p.weight,
                    dimensionLength: p.dimensionLength,
                    dimensionWidth: p.dimensionWidth,
                    dimensionHeight: p.dimensionHeight,
                    shelfLife: p.shelfLife,
                    warrantyPeriod: p.warrantyPeriod,
                    tags: p.tags,
                    imageUrl: p.imageUrl,
                    minThreshold: p.minThreshold,
                    isActive: !currentActive
                })
            });

            if (updateRes.ok) {
                showToast(currentActive ? 'Đã vô hiệu hóa sản phẩm.' : 'Đã kích hoạt sản phẩm.', 'success');
                loadProduct();
            } else {
                const data = await updateRes.json();
                showToast(data.message || 'Lỗi cập nhật.', 'error');
            }
        } catch (err) {
            showToast('Lỗi: ' + err.message, 'error');
        }
    }

    function escHtml(str) { const d = document.createElement('div'); d.textContent = str || ''; return d.innerHTML; }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        const d = new Date(dateStr);
        return d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }) + ' ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    }

    function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast-wms ${type}`;
        toast.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i> ${message}`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
    }

    // Event listeners for modal
    document.getElementById('attr-search')?.addEventListener('input', () => {
        attrModalPage = 1;
        renderAttrSelectionList();
    });
    document.getElementById('attr-filter-status')?.addEventListener('change', () => {
        attrModalPage = 1;
        renderAttrSelectionList();
    });

    loadProduct();
</script>

