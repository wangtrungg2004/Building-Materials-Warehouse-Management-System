@page
@model BmWms.Web.Pages.ProductManagement.ProductEditModel
@{
    ViewData["Title"] = "Edit Product";
    ViewData["ActivePage"] = "Products";
}

<div style="margin-bottom:16px;">
    <a href="/ProductManagement/Products" style="color:var(--color-accent);text-decoration:none;font-size:14px;font-weight:500;">
        <i class="bi bi-arrow-left"></i> Back to Product List
    </a>
</div>

<div style="margin-bottom:24px;">
    <h1 style="font-size:24px;font-weight:800;margin:0;color:var(--color-text-primary);">Edit Product</h1>
    <p style="color:var(--color-text-muted);margin:4px 0 0;font-size:14px;">Update product information.</p>
</div>

<!-- Basic Information -->
<div class="wms-card" style="margin-bottom:20px;">
    <div class="wms-card-body">
        <h3 style="font-size:16px;font-weight:700;margin:0 0 20px;color:var(--color-text-primary);">Basic Information</h3>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:16px;">
            <div class="wms-field">
                <label class="wms-label">Product Code <span style="color:var(--color-danger);">*</span></label>
                <input type="text" id="input-code" class="wms-input" placeholder="Enter product code" maxlength="50" style="text-transform:uppercase;">
            </div>
            <div class="wms-field">
                <label class="wms-label">Product Name <span style="color:var(--color-danger);">*</span></label>
                <input type="text" id="input-name" class="wms-input" placeholder="Enter product name" maxlength="200">
            </div>
            <div class="wms-field">
                <label class="wms-label">Product Group <span style="color:var(--color-danger);">*</span></label>
                <select id="input-group" class="wms-input">
                    <option value="">Select product group</option>
                </select>
            </div>
            <div class="wms-field">
                <label class="wms-label">Unit of Measure <span style="color:var(--color-danger);">*</span></label>
                <select id="input-unit" class="wms-input">
                    <option value="">Select unit</option>
                    <option value="Pcs">Pcs (Cái)</option>
                    <option value="Kg">Kg</option>
                    <option value="Bao">Bao</option>
                    <option value="Cây">Cây</option>
                    <option value="Tấm">Tấm</option>
                    <option value="M">M (Mét)</option>
                    <option value="M2">M² (Mét vuông)</option>
                    <option value="M3">M³ (Mét khối)</option>
                    <option value="Tấn">Tấn</option>
                    <option value="Pair">Pair (Đôi)</option>
                    <option value="Thùng">Thùng</option>
                    <option value="Cuộn">Cuộn</option>
                </select>
            </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:16px;">
            <div class="wms-field">
                <label class="wms-label">SKU (Stock Keeping Unit)</label>
                <input type="text" id="input-sku" class="wms-input" placeholder="Enter SKU" maxlength="50">
            </div>
            <div class="wms-field">
                <label class="wms-label">Barcode</label>
                <input type="text" id="input-barcode" class="wms-input" placeholder="Enter barcode" maxlength="50">
            </div>
            <div class="wms-field">
                <label class="wms-label">Brand</label>
                <input type="text" id="input-brand" class="wms-input" placeholder="Enter brand" maxlength="100">
            </div>
            <div class="wms-field">
                <label class="wms-label">Origin Country</label>
                <select id="input-country" class="wms-input">
                    <option value="">Select country</option>
                    <option value="Việt Nam">Việt Nam</option>
                    <option value="Trung Quốc">Trung Quốc</option>
                    <option value="Nhật Bản">Nhật Bản</option>
                    <option value="Hàn Quốc">Hàn Quốc</option>
                    <option value="Thái Lan">Thái Lan</option>
                    <option value="Đài Loan">Đài Loan</option>
                    <option value="Ấn Độ">Ấn Độ</option>
                    <option value="Đức">Đức</option>
                    <option value="Ý">Ý</option>
                    <option value="Mỹ">Mỹ</option>
                </select>
            </div>
        </div>
        <div class="wms-field">
            <label class="wms-label">Description</label>
            <div style="position:relative;">
                <textarea id="input-desc" class="wms-input" placeholder="Enter product description" rows="3" maxlength="500"
                    style="resize:vertical;" oninput="updateCharCount()"></textarea>
                <span id="char-count" style="position:absolute;bottom:8px;right:12px;font-size:12px;color:var(--color-text-muted);">0 / 500</span>
            </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="wms-field">
                <label class="wms-label">Status</label>
                <select id="input-status" class="wms-input">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Product Image & Additional Info -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
    <div class="wms-card">
        <div class="wms-card-body">
            <h3 style="font-size:16px;font-weight:700;margin:0 0 20px;color:var(--color-text-primary);">Product Image</h3>
            <div id="upload-area" style="border:2px dashed var(--color-border);border-radius:10px;padding:40px;text-align:center;cursor:pointer;transition:all 0.2s;"
                onclick="document.getElementById('file-input').click()"
                ondragover="event.preventDefault();this.style.borderColor='var(--color-accent)';this.style.background='#eff6ff';"
                ondragleave="this.style.borderColor='var(--color-border)';this.style.background='transparent';"
                ondrop="handleDrop(event)">
                <div id="upload-preview" style="display:none;">
                    <img id="preview-img" src="" style="max-width:200px;max-height:200px;border-radius:8px;margin-bottom:12px;">
                    <div><button class="btn-wms-secondary" onclick="event.stopPropagation();removeImage();" style="font-size:12px;padding:4px 12px;">Remove</button></div>
                </div>
                <div id="upload-placeholder">
                    <i class="bi bi-cloud-arrow-up" style="font-size:36px;color:var(--color-text-muted);"></i>
                    <div style="margin-top:8px;font-size:14px;"><strong>Click to upload</strong> or drag and drop</div>
                    <div style="color:var(--color-text-muted);font-size:12px;margin-top:4px;">PNG, JPG, JPEG (max 2MB)</div>
                </div>
            </div>
            <input type="file" id="file-input" accept=".png,.jpg,.jpeg" style="display:none;" onchange="handleFileSelect(event)">
            <input type="hidden" id="input-image-url" value="">
        </div>
    </div>

    <div class="wms-card">
        <div class="wms-card-body">
            <h3 style="font-size:16px;font-weight:700;margin:0 0 20px;color:var(--color-text-primary);">Additional Information</h3>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="wms-field">
                    <label class="wms-label">Weight</label>
                    <div style="display:flex;gap:8px;align-items:center;">
                        <input type="number" id="input-weight" class="wms-input" placeholder="Enter weight" step="0.01" min="0">
                        <span style="color:var(--color-text-muted);font-size:13px;white-space:nowrap;">kg</span>
                    </div>
                </div>
                <div class="wms-field">
                    <label class="wms-label">Dimensions (L x W x H)</label>
                    <div style="display:flex;gap:6px;align-items:center;">
                        <input type="number" id="input-length" class="wms-input" placeholder="L" step="0.01" min="0" style="flex:1;">
                        <input type="number" id="input-width" class="wms-input" placeholder="W" step="0.01" min="0" style="flex:1;">
                        <input type="number" id="input-height" class="wms-input" placeholder="H" step="0.01" min="0" style="flex:1;">
                        <span style="color:var(--color-text-muted);font-size:13px;white-space:nowrap;">cm</span>
                    </div>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="wms-field">
                    <label class="wms-label">Shelf Life</label>
                    <div style="display:flex;gap:8px;align-items:center;">
                        <input type="number" id="input-shelf" class="wms-input" placeholder="Enter shelf life" min="0">
                        <span style="color:var(--color-text-muted);font-size:13px;white-space:nowrap;">days</span>
                    </div>
                </div>
                <div class="wms-field">
                    <label class="wms-label">Warranty Period</label>
                    <div style="display:flex;gap:8px;align-items:center;">
                        <input type="number" id="input-warranty" class="wms-input" placeholder="Enter warranty" min="0">
                        <span style="color:var(--color-text-muted);font-size:13px;white-space:nowrap;">months</span>
                    </div>
                </div>
            </div>
            <div class="wms-field">
                <label class="wms-label">Min Threshold</label>
                <input type="number" id="input-threshold" class="wms-input" placeholder="Enter minimum threshold" step="0.01" min="0" value="0">
            </div>
            <div class="wms-field">
                <label class="wms-label">Tags</label>
                <input type="text" id="input-tags" class="wms-input" placeholder="Enter tags (comma separated)" maxlength="500">
            </div>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div style="display:flex;justify-content:flex-end;gap:12px;padding:20px 0;">
    <a href="/ProductManagement/Products" class="btn-wms-secondary">Cancel</a>
    <button class="btn-wms-primary" onclick="saveProduct()">Save Changes</button>
</div>

<div id="toast-container"></div>

@section Scripts {
<script>
    const productId = new URLSearchParams(window.location.search).get('id');

    async function loadGroups() {
        try {
            const res = await apiFetch('/api/productgroup/active');
            const groups = await res.json();
            const select = document.getElementById('input-group');
            groups.forEach(g => {
                const opt = document.createElement('option');
                opt.value = g.productGroupID;
                opt.textContent = g.groupName;
                select.appendChild(opt);
            });
        } catch (err) {
            console.error('Error loading groups:', err);
        }
    }

    async function loadProduct() {
        if (!productId) { window.location.href = '/ProductManagement/Products'; return; }

        try {
            const res = await apiFetch(`/api/product/${productId}`);
            if (!res.ok) { showToast('Product not found.', 'error'); return; }
            const p = await res.json();

            document.getElementById('input-code').value = p.productCode;
            document.getElementById('input-name').value = p.productName;
            document.getElementById('input-group').value = p.productGroupID;
            document.getElementById('input-unit').value = p.unitOfMeasure;
            document.getElementById('input-sku').value = p.sku || '';
            document.getElementById('input-barcode').value = p.barcode || '';
            document.getElementById('input-brand').value = p.brand || '';
            document.getElementById('input-country').value = p.originCountry || '';
            document.getElementById('input-desc').value = p.description || '';
            document.getElementById('input-status').value = p.isActive.toString();
            document.getElementById('input-weight').value = p.weight || '';
            document.getElementById('input-length').value = p.dimensionLength || '';
            document.getElementById('input-width').value = p.dimensionWidth || '';
            document.getElementById('input-height').value = p.dimensionHeight || '';
            document.getElementById('input-shelf').value = p.shelfLife || '';
            document.getElementById('input-warranty').value = p.warrantyPeriod || '';
            document.getElementById('input-threshold').value = p.minThreshold || 0;
            document.getElementById('input-tags').value = p.tags || '';
            document.getElementById('input-image-url').value = p.imageUrl || '';

            if (p.imageUrl) {
                document.getElementById('preview-img').src = p.imageUrl;
                document.getElementById('upload-preview').style.display = 'block';
                document.getElementById('upload-placeholder').style.display = 'none';
            }

            updateCharCount();
        } catch (err) {
            showToast('Error loading product: ' + err.message, 'error');
        }
    }

    function updateCharCount() {
        const textarea = document.getElementById('input-desc');
        document.getElementById('char-count').textContent = `${textarea.value.length} / 500`;
    }

    // ── Image Upload ───────────────────────────────────────
    async function handleFileSelect(e) { const file = e.target.files[0]; if (file) await uploadImage(file); }
    function handleDrop(e) {
        e.preventDefault();
        e.target.closest('#upload-area').style.borderColor = 'var(--color-border)';
        e.target.closest('#upload-area').style.background = 'transparent';
        const file = e.dataTransfer.files[0]; if (file) uploadImage(file);
    }
    async function uploadImage(file) {
        if (file.size > 2 * 1024 * 1024) { showToast('File quá lớn. Tối đa 2MB.', 'error'); return; }
        const formData = new FormData();
        formData.append('file', file);
        try {
            const token = Auth.getToken();
            const res = await fetch('/api/product/upload-image', {
                method: 'POST',
                headers: token ? { 'Authorization': 'Bearer ' + token } : {},
                body: formData
            });
            if (!res.ok) { const data = await res.json(); showToast(data.message || 'Upload thất bại.', 'error'); return; }
            const data = await res.json();
            document.getElementById('input-image-url').value = data.imageUrl;
            document.getElementById('preview-img').src = data.imageUrl;
            document.getElementById('upload-preview').style.display = 'block';
            document.getElementById('upload-placeholder').style.display = 'none';
        } catch (err) { showToast('Lỗi upload: ' + err.message, 'error'); }
    }
    function removeImage() {
        document.getElementById('input-image-url').value = '';
        document.getElementById('file-input').value = '';
        document.getElementById('upload-preview').style.display = 'none';
        document.getElementById('upload-placeholder').style.display = 'block';
    }

    // ── Save ───────────────────────────────────────────────
    async function saveProduct() {
        const code = document.getElementById('input-code').value.trim();
        const name = document.getElementById('input-name').value.trim();
        const groupId = document.getElementById('input-group').value;
        const unit = document.getElementById('input-unit').value;

        if (!code || !name || !groupId || !unit) {
            showToast('Vui lòng nhập đầy đủ các trường bắt buộc (*).', 'error');
            return;
        }

        const body = {
            productCode: code,
            productName: name,
            productGroupID: parseInt(groupId),
            unitOfMeasure: unit,
            sku: document.getElementById('input-sku').value.trim() || null,
            barcode: document.getElementById('input-barcode').value.trim() || null,
            brand: document.getElementById('input-brand').value.trim() || null,
            originCountry: document.getElementById('input-country').value || null,
            description: document.getElementById('input-desc').value.trim() || null,
            weight: parseFloat(document.getElementById('input-weight').value) || null,
            dimensionLength: parseFloat(document.getElementById('input-length').value) || null,
            dimensionWidth: parseFloat(document.getElementById('input-width').value) || null,
            dimensionHeight: parseFloat(document.getElementById('input-height').value) || null,
            shelfLife: parseInt(document.getElementById('input-shelf').value) || null,
            warrantyPeriod: parseInt(document.getElementById('input-warranty').value) || null,
            tags: document.getElementById('input-tags').value.trim() || null,
            imageUrl: document.getElementById('input-image-url').value || null,
            minThreshold: parseFloat(document.getElementById('input-threshold').value) || 0,
            isActive: document.getElementById('input-status').value === 'true'
        };

        try {
            const res = await apiFetch(`/api/product/${productId}`, {
                method: 'PUT',
                body: JSON.stringify(body)
            });
            const data = await res.json();
            if (!res.ok) { showToast(data.message || 'Lỗi cập nhật.', 'error'); return; }
            showToast('Cập nhật sản phẩm thành công!', 'success');
            setTimeout(() => window.location.href = `/ProductManagement/ProductDetail?id=${productId}`, 1000);
        } catch (err) {
            showToast('Lỗi: ' + err.message, 'error');
        }
    }

    function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast-wms ${type}`;
        toast.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i> ${message}`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
    }

    // ── Init ────────────────────────────────────────────────
    (async () => {
        await loadGroups();
        await loadProduct();
    })();
</script>
}
