@page
@model BmWms.Web.Pages.ProductManagement.ProductGroupsModel
@{
    ViewData["Title"] = "Product Group";
    ViewData["ActivePage"] = "ProductGroups";
}

<div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
    <div>
        <h1 style="font-size:24px;font-weight:800;margin:0;color:var(--color-text-primary);">Product Group</h1>
        <p style="color:var(--color-text-muted);margin:4px 0 0;font-size:14px;">Manage product groups in the system.</p>
    </div>
    <button class="btn-wms-primary" onclick="openCreateModal()" id="btn-add-group">
        <i class="bi bi-plus-lg"></i> Add Product Group
    </button>
</div>

<!-- Search & Filter -->
<div class="wms-card" style="margin-bottom:20px;">
    <div class="wms-card-body" style="padding:16px 20px;">
        <div style="display:flex;gap:12px;align-items:center;justify-content:flex-end;">
            <div style="position:relative;width:300px;">
                <input type="text" id="search-input" class="wms-input" placeholder="Search product group..."
                    style="padding-right:36px;" oninput="debounceSearch()">
                <i class="bi bi-search" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--color-text-muted);"></i>
            </div>
            <select id="filter-status" class="wms-input" style="width:140px;" onchange="loadData()">
                <option value="">All Status</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
    </div>
</div>

<!-- Data Table -->
<div class="wms-card">
    <div style="overflow-x:auto;">
        <table class="wms-table" id="group-table">
            <thead>
                <tr>
                    <th style="width:50px;">#</th>
                    <th>Group Code</th>
                    <th>Group Name</th>
                    <th>Description</th>
                    <th style="width:100px;">Status</th>
                    <th>Created By</th>
                    <th>Created Date</th>
                    <th style="width:100px;">Actions</th>
                </tr>
            </thead>
            <tbody id="table-body">
                <tr><td colspan="8" style="text-align:center;padding:40px;color:var(--color-text-muted);">Loading...</td></tr>
            </tbody>
        </table>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 20px;border-top:1px solid var(--color-border);">
        <div id="showing-info" style="font-size:13px;color:var(--color-text-muted);"></div>
        <div id="pagination" style="display:flex;gap:4px;"></div>
    </div>
</div>

<!-- Create/Edit Modal -->
<div id="modal-overlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:white;border-radius:12px;width:520px;max-width:90vw;box-shadow:0 20px 60px rgba(0,0,0,0.3);animation:slideIn 0.2s ease;">
        <div style="padding:20px 24px;border-bottom:1px solid var(--color-border);display:flex;justify-content:space-between;align-items:center;">
            <h3 id="modal-title" style="margin:0;font-size:18px;font-weight:700;">Add Product Group</h3>
            <button onclick="closeModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--color-text-muted);padding:4px;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div style="padding:24px;">
            <input type="hidden" id="edit-id" value="">
            <div class="wms-field">
                <label class="wms-label">Group Code <span style="color:var(--color-danger);">*</span></label>
                <input type="text" id="input-code" class="wms-input" placeholder="Enter group code" maxlength="50" style="text-transform:uppercase;">
            </div>
            <div class="wms-field">
                <label class="wms-label">Group Name <span style="color:var(--color-danger);">*</span></label>
                <input type="text" id="input-name" class="wms-input" placeholder="Enter group name" maxlength="100">
            </div>
            <div class="wms-field">
                <label class="wms-label">Description</label>
                <textarea id="input-desc" class="wms-input" placeholder="Enter description" rows="3" maxlength="500" style="resize:vertical;"></textarea>
            </div>
            <div id="input-status-field" class="wms-field" style="display:none;">
                <label class="wms-label">Status</label>
                <select id="input-status" class="wms-input">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>
        <div style="padding:16px 24px;border-top:1px solid var(--color-border);display:flex;justify-content:flex-end;gap:10px;">
            <button class="btn-wms-secondary" onclick="closeModal()">Cancel</button>
            <button class="btn-wms-primary" onclick="saveGroup()" id="btn-save">Save</button>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div id="delete-overlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1001;align-items:center;justify-content:center;">
    <div style="background:white;border-radius:12px;width:420px;max-width:90vw;box-shadow:0 20px 60px rgba(0,0,0,0.3);padding:24px;">
        <div style="text-align:center;">
            <div style="width:56px;height:56px;background:#fef2f2;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                <i class="bi bi-trash3" style="font-size:24px;color:var(--color-danger);"></i>
            </div>
            <h3 style="margin:0 0 8px;font-size:18px;font-weight:700;">Delete Product Group</h3>
            <p style="color:var(--color-text-muted);margin:0 0 20px;font-size:14px;" id="delete-message">Are you sure you want to delete this product group?</p>
        </div>
        <div style="display:flex;gap:10px;">
            <button class="btn-wms-secondary" onclick="closeDeleteModal()" style="flex:1;">Cancel</button>
            <button style="flex:1;padding:8px 16px;background:var(--color-danger);color:white;border:none;border-radius:7px;font-size:13.5px;font-weight:600;cursor:pointer;" onclick="confirmDelete()">Delete</button>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container"></div>

@section Scripts {
<script>
    let currentPage = 1;
    const pageSize = 10;
    let searchTimeout;
    let deleteTargetId = null;

    // ── Load data ──────────────────────────────────────────
    async function loadData() {
        const search = document.getElementById('search-input').value;
        const status = document.getElementById('filter-status').value;

        let url = `/api/productgroup?page=${currentPage}&pageSize=${pageSize}`;
        if (search) url += `&search=${encodeURIComponent(search)}`;
        if (status) url += `&isActive=${status}`;

        try {
            const res = await apiFetch(url);
            const data = await res.json();

            renderTable(data.items, data.totalCount, data.page, data.totalPages);
        } catch (err) {
            showToast('Lỗi tải dữ liệu: ' + err.message, 'error');
        }
    }

    function renderTable(items, totalCount, page, totalPages) {
        const tbody = document.getElementById('table-body');
        const startIndex = (page - 1) * pageSize;

        if (!items || items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;padding:40px;color:var(--color-text-muted);">No product groups found.</td></tr>';
            document.getElementById('showing-info').textContent = '';
            document.getElementById('pagination').innerHTML = '';
            return;
        }

        tbody.innerHTML = items.map((g, i) => `
            <tr>
                <td>${startIndex + i + 1}</td>
                <td><strong>${escHtml(g.groupCode)}</strong></td>
                <td>${escHtml(g.groupName)}</td>
                <td style="color:var(--color-text-muted);max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(g.description || '')}</td>
                <td><span class="${g.isActive ? 'badge-active' : 'badge-inactive'}">● ${g.isActive ? 'Active' : 'Inactive'}</span></td>
                <td>${escHtml(g.createdBy || '—')}</td>
                <td>${formatDate(g.createdAt)}</td>
                <td>
                    <div style="display:flex;gap:8px;">
                        <button onclick="openEditModal(${g.productGroupID})" style="background:none;border:none;cursor:pointer;color:var(--color-text-muted);font-size:16px;" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button onclick="openDeleteModal(${g.productGroupID}, '${escHtml(g.groupName)}')" style="background:none;border:none;cursor:pointer;color:var(--color-text-muted);font-size:16px;" title="Delete">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `).join('');

        // Showing info
        const from = startIndex + 1;
        const to = Math.min(startIndex + items.length, totalCount);
        document.getElementById('showing-info').textContent = `Showing ${from} to ${to} of ${totalCount} entries`;

        // Pagination
        renderPagination(page, totalPages);
    }

    function renderPagination(page, totalPages) {
        const container = document.getElementById('pagination');
        if (totalPages <= 1) { container.innerHTML = ''; return; }

        let html = '';
        html += `<button class="btn-page ${page <= 1 ? 'disabled' : ''}" onclick="goToPage(${page - 1})" ${page <= 1 ? 'disabled' : ''}>&lt;</button>`;

        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= page - 1 && i <= page + 1)) {
                html += `<button class="btn-page ${i === page ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
            } else if (i === page - 2 || i === page + 2) {
                html += `<span style="padding:4px 8px;color:var(--color-text-muted);">...</span>`;
            }
        }

        html += `<button class="btn-page ${page >= totalPages ? 'disabled' : ''}" onclick="goToPage(${page + 1})" ${page >= totalPages ? 'disabled' : ''}>&gt;</button>`;
        container.innerHTML = html;
    }

    function goToPage(page) { currentPage = page; loadData(); }

    function debounceSearch() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => { currentPage = 1; loadData(); }, 300);
    }

    // ── Modal: Create ──────────────────────────────────────
    function openCreateModal() {
        document.getElementById('modal-title').textContent = 'Add Product Group';
        document.getElementById('edit-id').value = '';
        document.getElementById('input-code').value = '';
        document.getElementById('input-name').value = '';
        document.getElementById('input-desc').value = '';
        document.getElementById('input-status-field').style.display = 'none';
        document.getElementById('input-code').disabled = false;
        document.getElementById('modal-overlay').style.display = 'flex';
    }

    // ── Modal: Edit ────────────────────────────────────────
    async function openEditModal(id) {
        try {
            const res = await apiFetch(`/api/productgroup/${id}`);
            if (!res.ok) { showToast('Không tìm thấy nhóm vật tư.', 'error'); return; }
            const g = await res.json();

            document.getElementById('modal-title').textContent = 'Edit Product Group';
            document.getElementById('edit-id').value = g.productGroupID;
            document.getElementById('input-code').value = g.groupCode;
            document.getElementById('input-name').value = g.groupName;
            document.getElementById('input-desc').value = g.description || '';
            document.getElementById('input-status').value = g.isActive.toString();
            document.getElementById('input-status-field').style.display = 'block';
            document.getElementById('input-code').disabled = false;
            document.getElementById('modal-overlay').style.display = 'flex';
        } catch (err) {
            showToast('Lỗi: ' + err.message, 'error');
        }
    }

    function closeModal() {
        document.getElementById('modal-overlay').style.display = 'none';
    }

    // ── Save (Create or Update) ────────────────────────────
    async function saveGroup() {
        const editId = document.getElementById('edit-id').value;
        const code = document.getElementById('input-code').value.trim();
        const name = document.getElementById('input-name').value.trim();
        const desc = document.getElementById('input-desc').value.trim();

        if (!code || !name) {
            showToast('Vui lòng nhập mã và tên nhóm vật tư.', 'error');
            return;
        }

        try {
            let res;
            if (editId) {
                const isActive = document.getElementById('input-status').value === 'true';
                res = await apiFetch(`/api/productgroup/${editId}`, {
                    method: 'PUT',
                    body: JSON.stringify({ groupCode: code, groupName: name, description: desc || null, isActive })
                });
            } else {
                res = await apiFetch('/api/productgroup', {
                    method: 'POST',
                    body: JSON.stringify({ groupCode: code, groupName: name, description: desc || null })
                });
            }

            const data = await res.json();
            if (!res.ok) {
                showToast(data.message || 'Lỗi khi lưu.', 'error');
                return;
            }

            showToast(editId ? 'Cập nhật thành công!' : 'Tạo nhóm vật tư thành công!', 'success');
            closeModal();
            loadData();
        } catch (err) {
            showToast('Lỗi: ' + err.message, 'error');
        }
    }

    // ── Delete ─────────────────────────────────────────────
    function openDeleteModal(id, name) {
        deleteTargetId = id;
        document.getElementById('delete-message').textContent = `Are you sure you want to delete "${name}"? This action cannot be undone.`;
        document.getElementById('delete-overlay').style.display = 'flex';
    }

    function closeDeleteModal() {
        document.getElementById('delete-overlay').style.display = 'none';
        deleteTargetId = null;
    }

    async function confirmDelete() {
        if (!deleteTargetId) return;
        try {
            const res = await apiFetch(`/api/productgroup/${deleteTargetId}`, { method: 'DELETE' });
            const data = await res.json();
            if (!res.ok) {
                showToast(data.message || 'Xóa thất bại.', 'error');
            } else {
                showToast('Xóa nhóm vật tư thành công!', 'success');
                loadData();
            }
        } catch (err) {
            showToast('Lỗi: ' + err.message, 'error');
        }
        closeDeleteModal();
    }

    // ── Helpers ─────────────────────────────────────────────
    function escHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function formatDate(dateStr) {
        if (!dateStr) return '—';
        const d = new Date(dateStr);
        return d.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' })
            + ' ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    }

    function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast-wms ${type}`;
        toast.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i> ${message}`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
    }

    // ── Init ────────────────────────────────────────────────
    loadData();
</script>

<style>
    .btn-page {
        min-width: 32px; height: 32px;
        border: 1px solid var(--color-border);
        background: white; border-radius: 6px;
        font-size: 13px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s;
    }
    .btn-page:hover:not(.disabled):not(.active) { background: var(--color-bg); }
    .btn-page.active { background: var(--color-accent); color: white; border-color: var(--color-accent); }
    .btn-page.disabled { opacity: 0.4; cursor: not-allowed; }
</style>
}
