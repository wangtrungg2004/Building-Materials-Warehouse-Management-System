@page
@model BmWms.Web.Pages.ProductManagement.ProductAttributesModel
@{
    ViewData["Title"] = "Product Attributes";
    ViewData["ActivePage"] = "ProductAttributes";
}

<div class="page-header" style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
    <div>
        <h1 style="font-size:24px;font-weight:800;margin:0;color:var(--color-text-primary);">Product Attributes</h1>
        <p style="color:var(--color-text-muted);margin:4px 0 0;font-size:14px;">Define attributes and their values for products</p>
    </div>
    <button class="btn-wms-primary" onclick="openCreateModal()">
        <i class="bi bi-plus-lg"></i> Add Attribute
    </button>
</div>

<!-- Search & Filter -->
<div class="wms-card" style="margin-bottom:20px;">
    <div class="wms-card-body" style="padding:16px 20px;">
        <div style="display:flex;gap:12px;align-items:center;justify-content:flex-end;">
            <div style="position:relative;width:300px;">
                <input type="text" id="search-input" class="wms-input" placeholder="Search by code or name..." style="padding-right:36px;">
                <i class="bi bi-search" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:var(--color-text-muted);"></i>
            </div>
            <select id="filter-status" class="wms-input" style="width:140px;">
                <option value="">All Status</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
    </div>
</div>

<!-- Data Table -->
<div class="wms-card">
    <div style="overflow-x:auto;">
        <table class="wms-table" id="attr-table">
            <thead>
                <tr>
                    <th style="width:50px;">#</th>
                    <th>Code</th>
                    <th>Attribute Name</th>
                    <th style="width:300px;">Values</th>
                    <th style="width:80px;">Status</th>
                    <th style="width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody id="table-body">
                <tr><td colspan="6" style="text-align:center;padding:40px;color:var(--color-text-muted);">Loading...</td></tr>
            </tbody>
        </table>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 20px;border-top:1px solid var(--color-border);">
        <div id="showing-info" style="font-size:13px;color:var(--color-text-muted);"></div>
        <div style="display:flex;gap:12px;align-items:center;">
            <div id="pagination" style="display:flex;gap:4px;align-items:center;flex-wrap:nowrap;"></div>
            <select id="page-size" class="wms-input" style="width:110px;">
                <option value="10">10 / page</option>
                <option value="25">25 / page</option>
                <option value="50">50 / page</option>
            </select>
        </div>
    </div>
</div>

<!-- Create/Edit Attribute Modal -->
<div id="modal-overlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:white;border-radius:16px;width:520px;max-width:95vw;box-shadow:0 25px 80px rgba(0,0,0,0.25);animation:modalSlideIn 0.25s ease;">
        <div style="padding:20px 28px;border-bottom:1px solid var(--color-border);display:flex;justify-content:space-between;align-items:center;">
            <div>
                <h3 id="modal-title" style="margin:0;font-size:18px;font-weight:700;">Add Attribute</h3>
                <p id="modal-subtitle" style="margin:4px 0 0;font-size:13px;color:var(--color-text-muted);">Define attribute properties</p>
            </div>
            <button onclick="closeModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--color-text-muted);padding:8px;border-radius:8px;transition:all 0.2s;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        
        <div style="padding:24px 28px;">
            <input type="hidden" id="edit-id" value="">
            
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
                <div class="wms-field">
                    <label class="wms-label">Attribute Code <span style="color:var(--color-danger);">*</span></label>
                    <input type="text" id="input-code" class="wms-input" placeholder="e.g., COLOR" maxlength="50" style="text-transform:uppercase;">
                </div>
                <div class="wms-field">
                    <label class="wms-label">Attribute Name <span style="color:var(--color-danger);">*</span></label>
                    <input type="text" id="input-name" class="wms-input" placeholder="e.g., Màu Sắc" maxlength="100">
                </div>
            </div>
            
            <div class="wms-field" style="margin-bottom:20px;">
                <label class="wms-label">Description</label>
                <input type="text" id="input-description" class="wms-input" placeholder="Optional description..." maxlength="500">
            </div>
            
            <div id="input-status-field" class="wms-field" style="display:none;">
                <label class="wms-label">Status</label>
                <select id="input-status" class="wms-input">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>
        
        <div style="padding:16px 28px;border-top:1px solid var(--color-border);display:flex;justify-content:flex-end;gap:12px;background:#fafbfc;border-radius:0 0 16px 16px;">
            <button onclick="closeModal()" class="btn-wms-secondary">Cancel</button>
            <button onclick="saveAttribute()" class="btn-wms-primary">
                <i class="bi bi-check-lg"></i> Save Attribute
            </button>
        </div>
    </div>
</div>

<!-- Manage Values Modal -->
<div id="values-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1001;align-items:center;justify-content:center;">
    <div style="background:white;border-radius:16px;width:560px;max-width:95vw;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 25px 80px rgba(0,0,0,0.25);animation:modalSlideIn 0.25s ease;">
        <div style="padding:20px 28px;border-bottom:1px solid var(--color-border);display:flex;justify-content:space-between;align-items:center;">
            <div>
                <h3 id="values-modal-title" style="margin:0;font-size:18px;font-weight:700;">Manage Values</h3>
                <p id="values-modal-subtitle" style="margin:4px 0 0;font-size:13px;color:var(--color-text-muted);">Add attribute values</p>
            </div>
            <button onclick="closeValuesModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--color-text-muted);padding:8px;border-radius:8px;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        
        <div style="padding:20px 28px;border-bottom:1px solid var(--color-border);background:#fafbfc;">
            <div style="display:flex;gap:12px;align-items:flex-end;">
                <div style="flex:1;">
                    <label class="wms-label" style="font-size:12px;">Value Name <span style="color:var(--color-danger);">*</span></label>
                    <input type="text" id="value-name" class="wms-input" placeholder="e.g., Đỏ" maxlength="100">
                </div>
                <button onclick="saveValue()" class="btn-wms-primary" style="white-space:nowrap;">
                    <i class="bi bi-plus-lg"></i> Add
                </button>
            </div>
        </div>
        
        <div style="flex:1;overflow-y:auto;padding:16px 28px;">
            <input type="hidden" id="editing-value-id" value="">
            <table class="wms-table" id="values-table">
                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th>Name</th>
                        <th style="width:80px;">Status</th>
                        <th style="width:80px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="values-table-body">
                    <tr><td colspan="4" style="text-align:center;padding:30px;color:var(--color-text-muted);">No values yet</td></tr>
                </tbody>
            </table>
        </div>
        
        <div style="padding:16px 28px;border-top:1px solid var(--color-border);display:flex;justify-content:flex-end;background:#fafbfc;border-radius:0 0 16px 16px;">
            <button onclick="closeValuesModal()" class="btn-wms-secondary">Close</button>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div id="delete-overlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1002;align-items:center;justify-content:center;">
    <div style="background:white;border-radius:16px;width:420px;max-width:90vw;box-shadow:0 25px 80px rgba(0,0,0,0.25);padding:28px;animation:modalSlideIn 0.2s ease;">
        <div style="text-align:center;">
            <div style="width:64px;height:64px;background:#fef2f2;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
                <i class="bi bi-trash3" style="font-size:28px;color:#dc2626;"></i>
            </div>
            <h3 style="margin:0 0 8px;font-size:20px;font-weight:700;">Delete</h3>
            <p style="color:var(--color-text-muted);margin:0 0 24px;font-size:14px;line-height:1.5;" id="delete-message"></p>
        </div>
        <div style="display:flex;gap:12px;">
            <button class="btn-wms-secondary" onclick="closeDeleteModal()" style="flex:1;padding:12px;">Cancel</button>
            <button style="flex:1;padding:12px;background:#dc2626;color:white;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;" onclick="confirmDelete()">
                <i class="bi bi-trash3"></i> Delete
            </button>
        </div>
    </div>
</div>

<div id="toast-container"></div>

@section Scripts {
<script>
    let currentPage = 1;
    let pageSize = 10;
    let searchTimeout;
    let deleteTargetId = null;
    let deleteType = null;
    let currentAttributeId = null;
    let currentAttributeName = '';

    async function loadData() {
        const keyword = document.getElementById('search-input').value;
        const status = document.getElementById('filter-status').value;

        let url = `/api/productattribute?page=${currentPage}&pageSize=${pageSize}`;
        if (keyword) url += `&keyword=${encodeURIComponent(keyword)}`;
        if (status) url += `&isActive=${status}`;

        try {
            const res = await apiFetch(url);
            const data = await res.json();
            renderTable(data.items, data.totalCount, data.page, data.totalPages);
        } catch (err) {
            showToast('Error loading data: ' + err.message, 'error');
        }
    }

    function renderTable(items, totalCount, page, totalPages) {
        const tbody = document.getElementById('table-body');

        if (!items || items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--color-text-muted);">No attributes found.</td></tr>';
            document.getElementById('showing-info').textContent = '';
            document.getElementById('pagination').innerHTML = '';
            return;
        }

        const startIndex = (page - 1) * pageSize;

        tbody.innerHTML = items.map((a, i) => {
            const values = a.values || [];
            let valuesHtml = '—';
            if (values.length > 0) {
                valuesHtml = values.slice(0, 4).map(v => {
                    return `<span style="display:inline-block;padding:2px 8px;background:#e2e8f0;border-radius:4px;font-size:11px;margin:2px;">${escHtml(v.valueName)}</span>`;
                }).join('');
                if (values.length > 4) {
                    valuesHtml += `<span style="display:inline-block;padding:2px 8px;background:#e2e8f0;border-radius:4px;font-size:11px;margin:2px;color:var(--color-text-muted);">+${values.length - 4}</span>`;
                }
            }
            
            return `
            <tr style="transition:background 0.15s;">
                <td style="font-weight:600;color:var(--color-text-muted);">${startIndex + i + 1}</td>
                <td><strong style="color:var(--color-accent);">${escHtml(a.attributeCode)}</strong></td>
                <td style="font-weight:500;">${escHtml(a.attributeName)}</td>
                <td>${valuesHtml}</td>
                <td style="white-space:nowrap;"><span class="${a.isActive ? 'badge-active' : 'badge-inactive'}">● ${a.isActive ? 'Active' : 'Inactive'}</span></td>
                <td>
                    <div style="display:flex;gap:4px;">
                        <button onclick="openValuesModal(${a.attributeID}, '${escJs(a.attributeName)}')" style="background:#dbeafe;border:none;cursor:pointer;color:#2563eb;font-size:14px;padding:6px 8px;border-radius:6px;transition:all 0.15s;" title="Manage Values">
                            <i class="bi bi-list-ul"></i>
                        </button>
                        <button onclick="openEditModal(${a.attributeID})" style="background:#f1f5f9;border:none;cursor:pointer;color:var(--color-text-muted);font-size:14px;padding:6px 8px;border-radius:6px;transition:all 0.15s;" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button onclick="openDeleteModal(${a.attributeID}, '${escJs(a.attributeName)}', 'attribute')" style="background:#f1f5f9;border:none;cursor:pointer;color:#dc2626;font-size:14px;padding:6px 8px;border-radius:6px;transition:all 0.15s;" title="Delete">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `}).join('');

        const from = startIndex + 1;
        const to = Math.min(startIndex + items.length, totalCount);
        document.getElementById('showing-info').textContent = `Showing ${from} to ${to} of ${totalCount} entries`;
        renderPagination(page, totalPages);
    }

    function renderPagination(page, totalPages) {
        const container = document.getElementById('pagination');
        if (totalPages <= 1) { container.innerHTML = ''; return; }

        let html = `<button class="btn-page ${page <= 1 ? 'disabled' : ''}" onclick="goToPage(${page - 1})" ${page <= 1 ? 'disabled' : ''}>&lt;</button>`;

        const maxVisible = 5;
        let start = Math.max(1, page - 2);
        let end = Math.min(totalPages, start + maxVisible - 1);
        if (end - start < maxVisible - 1) start = Math.max(1, end - maxVisible + 1);

        if (start > 1) html += `<button class="btn-page" onclick="goToPage(1)">1</button><span style="padding:0 4px;color:var(--color-text-muted);">...</span>`;

        for (let i = start; i <= end; i++) {
            html += `<button class="btn-page ${i === page ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
        }

        if (end < totalPages) html += `<span style="padding:0 4px;color:var(--color-text-muted);">...</span><button class="btn-page" onclick="goToPage(${totalPages})">${totalPages}</button>`;

        html += `<button class="btn-page ${page >= totalPages ? 'disabled' : ''}" onclick="goToPage(${page + 1})" ${page >= totalPages ? 'disabled' : ''}>&gt;</button>`;
        container.innerHTML = html;
    }

    function goToPage(p) { currentPage = p; loadData(); }
    function changePageSize() { pageSize = parseInt(document.getElementById('page-size').value); currentPage = 1; loadData(); }

    // Attribute Modal
    function openCreateModal() {
        document.getElementById('modal-title').textContent = 'Add Attribute';
        document.getElementById('modal-subtitle').textContent = 'Define attribute properties';
        document.getElementById('edit-id').value = '';
        document.getElementById('input-code').value = '';
        document.getElementById('input-name').value = '';
        document.getElementById('input-description').value = '';
        document.getElementById('input-status-field').style.display = 'none';
        document.getElementById('modal-overlay').style.display = 'flex';
    }

    async function openEditModal(id) {
        try {
            const res = await apiFetch(`/api/productattribute/${id}`);
            const a = await res.json();

            document.getElementById('modal-title').textContent = 'Edit Attribute';
            document.getElementById('modal-subtitle').textContent = 'Update attribute configuration';
            document.getElementById('edit-id').value = a.attributeID;
            document.getElementById('input-code').value = a.attributeCode;
            document.getElementById('input-name').value = a.attributeName;
            document.getElementById('input-description').value = a.description || '';
            document.getElementById('input-status').value = a.isActive ? 'true' : 'false';
            document.getElementById('input-status-field').style.display = 'block';
            
            document.getElementById('modal-overlay').style.display = 'flex';
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
        }
    }

    function closeModal() {
        document.getElementById('modal-overlay').style.display = 'none';
    }

    async function saveAttribute() {
        const id = document.getElementById('edit-id').value;
        const code = document.getElementById('input-code').value.trim();
        const name = document.getElementById('input-name').value.trim();
        const description = document.getElementById('input-description').value.trim();
        const isActive = document.getElementById('input-status').value === 'true';

        if (!code || !name) {
            showToast('Please fill in all required fields.', 'error');
            return;
        }

        const body = { attributeCode: code, attributeName: name, description };
        if (id) body.isActive = isActive;

        try {
            const url = id ? `/api/productattribute/${id}` : '/api/productattribute';
            const method = id ? 'PUT' : 'POST';
            const res = await apiFetch(url, { method, body: JSON.stringify(body) });

            if (res.ok) {
                showToast(id ? 'Updated successfully!' : 'Created successfully!', 'success');
                closeModal();
                loadData();
            } else {
                const data = await res.json();
                showToast(data.message || 'Error!', 'error');
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
        }
    }

    // Values Modal
    async function openValuesModal(attrId, attrName) {
        currentAttributeId = attrId;
        currentAttributeName = attrName;
        
        document.getElementById('values-modal-title').textContent = `Values: ${attrName}`;
        document.getElementById('values-modal-subtitle').textContent = 'Add attribute values';
        document.getElementById('value-name').value = '';
        document.getElementById('editing-value-id').value = '';
        
        await loadValues();
        document.getElementById('values-modal').style.display = 'flex';
    }

    function closeValuesModal() {
        document.getElementById('values-modal').style.display = 'none';
        currentAttributeId = null;
    }

    async function loadValues() {
        if (!currentAttributeId) return;
        
        try {
            const res = await apiFetch(`/api/productattributevalue/by-attribute/${currentAttributeId}`);
            const values = await res.json();
            renderValuesTable(values);
        } catch (err) {
            showToast('Error loading values: ' + err.message, 'error');
        }
    }

    function renderValuesTable(values) {
        const tbody = document.getElementById('values-table-body');
        
        if (!values || values.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:30px;color:var(--color-text-muted);">No values yet. Add your first value below.</td></tr>';
            return;
        }

        tbody.innerHTML = values.map((v, i) => {
            return `
            <tr>
                <td style="font-weight:600;color:var(--color-text-muted);">${i + 1}</td>
                <td>${escHtml(v.valueName)}</td>
                <td style="white-space:nowrap;"><span class="${v.isActive ? 'badge-active' : 'badge-inactive'}">● ${v.isActive ? 'Active' : 'Inactive'}</span></td>
                <td>
                    <div style="display:flex;gap:4px;">
                        <button onclick="deleteValue(${v.valueID}, '${escJs(v.valueName)}')" style="background:#f1f5f9;border:none;cursor:pointer;color:#dc2626;font-size:13px;padding:4px 6px;border-radius:4px;" title="Delete">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `}).join('');
    }

    async function saveValue() {
        const name = document.getElementById('value-name').value.trim();

        if (!name) {
            showToast('Please enter value name.', 'error');
            return;
        }

        try {
            const res = await apiFetch(`/api/productattributevalue?attributeId=${currentAttributeId}`, {
                method: 'POST',
                body: JSON.stringify({ valueName: name })
            });

            if (res.ok) {
                showToast('Added successfully!', 'success');
                document.getElementById('value-name').value = '';
                await loadValues();
                loadData();
            } else {
                const data = await res.json();
                showToast(data.message || 'Error!', 'error');
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
        }
    }

    async function deleteValue(id, name) {
        if (!confirm(`Delete value "${name}"?`)) return;
        
        try {
            const res = await apiFetch(`/api/productattributevalue/${id}`, { method: 'DELETE' });
            if (res.ok) {
                showToast('Deleted successfully!', 'success');
                await loadValues();
                loadData();
            } else {
                const data = await res.json();
                showToast(data.message || 'Error!', 'error');
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
        }
    }

    // Delete
    function openDeleteModal(id, name, type) {
        deleteTargetId = id;
        deleteType = type;
        const typeLabel = type === 'attribute' ? 'attribute' : 'value';
        document.getElementById('delete-message').textContent = `Are you sure you want to delete this ${typeLabel} "${name}"?`;
        document.getElementById('delete-overlay').style.display = 'flex';
    }

    function closeDeleteModal() {
        document.getElementById('delete-overlay').style.display = 'none';
        deleteTargetId = null;
        deleteType = null;
    }

    async function confirmDelete() {
        if (!deleteTargetId) return;
        
        try {
            const url = deleteType === 'value' 
                ? `/api/productattributevalue/${deleteTargetId}`
                : `/api/productattribute/${deleteTargetId}`;
            const res = await apiFetch(url, { method: 'DELETE' });
            
            if (res.ok) {
                showToast('Deleted successfully!', 'success');
                if (deleteType === 'value') {
                    await loadValues();
                    loadData();
                } else {
                    loadData();
                }
            } else {
                const data = await res.json();
                showToast(data.message || 'Delete failed.', 'error');
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
        }
        closeDeleteModal();
    }

    // Helpers
    function escHtml(str) { const d = document.createElement('div'); d.textContent = str || ''; return d.innerHTML; }
    function escJs(str) { return (str || '').replace(/'/g, "\\'").replace(/"/g, '\\"'); }

    function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast-wms ${type}`;
        toast.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i> ${message}`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
    }

    // Event listeners
    document.getElementById('search-input').addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => { currentPage = 1; loadData(); }, 300);
    });
    document.getElementById('filter-status').addEventListener('change', () => { currentPage = 1; loadData(); });
    document.getElementById('page-size').addEventListener('change', changePageSize);

    document.getElementById('value-name')?.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') saveValue();
    });

    loadData();
</script>

<style>
    .btn-page {
        min-width: 32px; height: 32px;
        border: 1px solid var(--color-border);
        background: white; border-radius: 6px;
        font-size: 13px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.15s;
    }
    .btn-page:hover:not(.disabled):not(.active) { background: var(--color-bg); }
    .btn-page.active { background: var(--color-accent); color: white; border-color: var(--color-accent); }
    .btn-page.disabled { opacity: 0.4; cursor: not-allowed; }
    
    @@keyframes modalSlideIn { 
        from { opacity: 0; transform: translateY(-20px) scale(0.95); } 
        to { opacity: 1; transform: translateY(0) scale(1); } 
    }
</style>
}
