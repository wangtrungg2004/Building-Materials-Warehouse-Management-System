@page
@model BmWms.Web.Pages.Warehouse.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BMWMS - Warehouse List</title>

    <link rel="stylesheet" href="~/css/Warehouse/index.css" />
</head>

<body>

    <!-- ================= SIDEBAR (GIỮ NGUYÊN UI) ================= -->
    <aside class="sidebar">

        <div class="sidebar-logo">
            <div class="logo-icon">🏢</div>
            <div class="logo-text">
                <div class="brand">BMWMS</div>
                <div class="sub">Warehouse Management System</div>
            </div>
        </div>

        <nav class="sidebar-nav">

            <a class="nav-item" href="#">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
                Dashboard
            </a>

            <div class="nav-section-label">MASTER DATA</div>

            <div class="nav-item active-parent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
                </svg>
                Warehouse Management
            </div>

            <div class="nav-sub">
                <div class="nav-sub-item active">Warehouse List</div>
                <div class="nav-sub-item">Storage Location</div>
            </div>

        </nav>
    </aside>

    <!-- ================= MAIN ================= -->
    <div class="main">

        <!-- TOPBAR -->
        <div class="topbar">

            <div class="breadcrumb">
                <span>Warehouse Management</span>
                <span class="sep">›</span>
                <span class="current">Warehouse List</span>
            </div>

            <div class="topbar-right">
                <div class="user-info">
                    <div class="avatar">NA</div>
                    <div class="user-details">
                        <div class="user-name">Nguyen Van A</div>
                        <div class="user-role">Warehouse Manager</div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ================= CONTENT ================= -->
        <div class="content">

            <div class="page-title">Warehouse List</div>
            <div class="page-sub">View and manage all warehouses in the system.</div>

            <!-- ================= FILTER BAR ================= -->
            <div class="filter-bar">

                <input id="txtCode" class="filter-input" placeholder="Warehouse Code">
                <input id="txtName" class="filter-input" placeholder="Warehouse Name">

                <select id="ddlStatus" class="filter-select">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>

                <select id="ddlCity" class="filter-select">
                    <option value="">All City</option>
                    <option>Hanoi</option>
                    <option>Ho Chi Minh City</option>
                    <option>Da Nang</option>
                </select>

                <input id="txtSearch" class="search-input" placeholder="Search...">

                <button class="btn-create" onclick="loadWarehouses()">
                    Reload
                </button>

            </div>

            <!-- ================= TABLE ================= -->
            <div class="table-card">

                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Address</th>
                            <th>City</th>
                            <th>Manager</th>
                            <th>Status</th>
                            <th>Locations</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <!-- IMPORTANT: AJAX TARGET -->
                    <tbody id="warehouseTableBody">
                        <tr>
                            <td colspan="9" style="text-align:center;padding:20px;">
                                Loading data...
                            </td>
                        </tr>
                    </tbody>

                </table>

                <div class="table-footer">
                    <span id="resultInfo">Loading...</span>
                </div>

            </div>
        </div>

        <!-- ================= FOOTER ================= -->
        <div class="page-footer">
            <span>© 2024 BMWMS</span>
            <span>Version 1.0.0</span>
        </div>

    </div>

    <!-- ================= JAVASCRIPT AJAX ================= -->
    <script>

        async function loadWarehouses() {

            try {

                const code = document.getElementById("txtCode").value;
                const name = document.getElementById("txtName").value;
                const status = document.getElementById("ddlStatus").value;
                const city = document.getElementById("ddlCity").value;
                const search = document.getElementById("txtSearch").value;

                // ✅ IMPORTANT: same project => relative API
                const url = `/api/warehouses?page=1&pageSize=50`
                    + `&code=${code}&name=${name}&status=${status}&city=${city}&search=${search}`;

                const res = await fetch(url);

                if (!res.ok) throw new Error("API error: " + res.status);

                const result = await res.json();
                const data = result.data || [];

                const tbody = document.getElementById("warehouseTableBody");
                tbody.innerHTML = "";

                if (data.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="9" style="text-align:center;padding:20px;">
                                No data found
                            </td>
                        </tr>`;
                    return;
                }

                data.forEach((item, index) => {

                    tbody.innerHTML += `
                        <tr>
                            <td>${index + 1}</td>
                            <td>${item.warehouseCode ?? ""}</td>
                            <td>${item.warehouseName ?? ""}</td>
                            <td>${item.address ?? ""}</td>
                            <td>${item.city ?? ""}</td>

                            <td>
                                ${item.managerName ?? ""}<br/>
                                <span class="phone">${item.managerPhone ?? ""}</span>
                            </td>

                            <td>
                                <span class="badge-status ${item.status === "Active" ? "badge-active" : "badge-inactive"}">
                                    ${item.status ?? ""}
                                </span>
                            </td>

                            <td style="text-align:center;">
                                ${item.totalLocations ?? 0}
                            </td>

                            <td>
                                <a href="/Warehouse/Detail?id=${item.warehouseID}">
                                    👁 View
                                </a>
                            </td>
                        </tr>
                    `;
                });

                document.getElementById("resultInfo").innerText =
                    `Total: ${data.length} records`;

            } catch (err) {

                console.error(err);

                document.getElementById("warehouseTableBody").innerHTML = `
                    <tr>
                        <td colspan="9" style="text-align:center;color:red;">
                            Failed to load data
                        </td>
                    </tr>`;
            }
        }

        // auto load
        document.addEventListener("DOMContentLoaded", loadWarehouses);

    </script>

</body>
</html>