@page
@model BmWms.Web.Pages.Warehouse.DetailModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BMWMS – Warehouse Detail</title>
    <style>
    </style>
    <link rel="stylesheet" href="~/css/Warehouse/Detail.css" />
</head>

<body>

    <!-- ══════════════════════════════
         SIDEBAR
    ══════════════════════════════ -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" />
                    <rect x="14" y="14" width="7" height="7" rx="1" />
                </svg>
            </div>
            <div class="logo-text">
                <div class="logo-title">BMWMS</div>
                <div class="logo-sub">Warehouse Management System</div>
            </div>
        </div>

        <!-- Dashboard -->
        <div class="sidebar-item" style="margin-top:6px;">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" />
                    <rect x="14" y="14" width="7" height="7" rx="1" />
                </svg>
            </span>
            Dashboard
        </div>

        <div class="sidebar-section-label">MASTER DATA</div>

        <!-- Warehouse Management (open) -->
        <div class="sidebar-item active-group" style="background:#26374d;">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
            </span>
            Warehouse Management
            <span class="chevron">&#8963;</span>
        </div>
        <div class="sidebar-sub">
            <div class="sidebar-item active">Warehouse List</div>
            <div class="sidebar-item">Storage Location</div>
        </div>

        <!-- Product Management -->
        <div class="sidebar-item">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" />
                    <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
                </svg>
            </span>
            Product Management
            <span class="chevron">&#8964;</span>
        </div>

        <div class="sidebar-section-label">OPERATIONS</div>

        <div class="sidebar-item">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </span>
            Inbound
            <span class="chevron">&#8964;</span>
        </div>
        <div class="sidebar-item">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 12H5M12 19l-7-7 7-7" />
                </svg>
            </span>
            Outbound
            <span class="chevron">&#8964;</span>
        </div>
        <div class="sidebar-item">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="17 1 21 5 17 9" />
                    <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                    <polyline points="7 23 3 19 7 15" />
                    <path d="M21 13v2a4 4 0 0 1-4 4H3" />
                </svg>
            </span>
            Transfer
            <span class="chevron">&#8964;</span>
        </div>
        <div class="sidebar-item">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4" />
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                </svg>
            </span>
            Audit
            <span class="chevron">&#8964;</span>
        </div>

        <div class="sidebar-section-label">REPORTS</div>

        <div class="sidebar-item">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                    <polyline points="10 9 9 9 8 9" />
                </svg>
            </span>
            Reports
            <span class="chevron">&#8964;</span>
        </div>
        <div class="sidebar-item">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
            </span>
            Analytics
            <span class="chevron">&#8964;</span>
        </div>

        <div class="sidebar-section-label">SYSTEM</div>

        <div class="sidebar-item">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </span>
            User Management
            <span class="chevron">&#8964;</span>
        </div>
        <div class="sidebar-item">
            <span class="icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14" />
                </svg>
            </span>
            System Settings
            <span class="chevron">&#8964;</span>
        </div>

        <div class="sidebar-bottom">
            <div class="sidebar-collapse">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
                Collapse
            </div>
        </div>
    </aside>

    <!-- ══════════════════════════════
         MAIN
    ══════════════════════════════ -->
    <div class="main">
        <!-- TOPBAR -->
        <div class="topbar">
            <div class="breadcrumb">
                <a href="#">Warehouse Management</a>
                <span class="sep">&rsaquo;</span>
                <a href="#">Warehouses</a>
                <span class="sep">&rsaquo;</span>
                <span class="current">Warehouse Detail</span>
            </div>
            <div class="topbar-right">
                <div class="topbar-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <span class="badge">5</span>
                </div>
                <div class="topbar-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="16" x2="12" y2="12" />
                        <line x1="12" y1="8" x2="12.01" y2="8" />
                    </svg>
                </div>
                <div class="user-info">
                    <div class="user-avatar">N</div>
                    <div>
                        <div class="user-name">Nguyen Van A</div>
                        <div class="user-role">Warehouse Manager</div>
                    </div>
                    <span class="user-chevron">&#8964;</span>
                </div>
            </div>
        </div>

        <!-- PAGE CONTENT -->
        <div class="content">
            <div class="page-title">Warehouse Detail</div>

            <!-- TOOLBAR -->
            <div class="toolbar">
                <button class="btn-back btn" onclick="location.href='/Warehouse/Index'">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6" />
                    </svg>
                    Back to Warehouse List
                </button>
                <div class="spacer"></div>
                <button class="btn btn-edit">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                    </svg>
                    Edit
                </button>
                <button class="btn btn-deactivate">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                    </svg>
                    Deactivate
                </button>

                <!-- More dropdown -->
                <div class="dropdown-wrapper">
                    <button class="btn btn-more" onclick="toggleDropdown()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12" />
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <line x1="3" y1="18" x2="21" y2="18" />
                        </svg>
                        More
                        <span style="font-size:11px;color:#8fa3b8;">&#8963;</span>
                    </button>
                    <div class="dropdown-menu" id="moreMenu">
                        <div class="dropdown-item">
                            <span class="di-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                    <circle cx="12" cy="10" r="3" />
                                </svg>
                            </span>
                            View Storage Locations
                        </div>
                        <div class="dropdown-item">
                            <span class="di-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M5 8h14M5 8a2 2 0 1 1 0-4h14a2 2 0 1 1 0 4M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8" />
                                </svg>
                            </span>
                            View Inventory
                        </div>
                        <div class="dropdown-item">
                            <span class="di-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                </svg>
                            </span>
                            View Transactions
                        </div>
                        <div class="dropdown-divider"></div>
                        <div class="dropdown-item">
                            <span class="di-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <rect x="9" y="9" width="13" height="13" rx="2" />
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                </svg>
                            </span>
                            Duplicate Warehouse
                        </div>
                        <div class="dropdown-item">
                            <span class="di-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <polyline points="6 9 6 2 18 2 18 9" />
                                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                                    <rect x="6" y="14" width="12" height="8" />
                                </svg>
                            </span>
                            Print
                        </div>
                        <div class="dropdown-divider"></div>
                        <div class="dropdown-item">
                            <span class="di-icon">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                    <polyline points="7 10 12 15 17 10" />
                                    <line x1="12" y1="15" x2="12" y2="3" />
                                </svg>
                            </span>
                            Export
                            <span class="di-chevron">&#8250;</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CARD -->
            <div class="card">
                <div class="card-title">Basic Information</div>

                <div class="field-row">
                    <div class="field-label">Warehouse Code</div>
                    <div class="field-value">WH001</div>
                </div>
                <div class="field-row">
                    <div class="field-label">Warehouse Name</div>
                    <div class="field-value">Hanoi Warehouse</div>
                </div>
                <div class="field-row">
                    <div class="field-label">Status</div>
                    <div class="field-value"><span class="badge-active">Active</span></div>
                </div>
                <div class="field-row">
                    <div class="field-label">Address</div>
                    <div class="field-value">123 Nguyen Trai St., Thanh Xuan District, Hanoi, Vietnam</div>
                </div>
                <div class="field-row">
                    <div class="field-label">City</div>
                    <div class="field-value">Hanoi</div>
                </div>
                <div class="field-row">
                    <div class="field-label">District</div>
                    <div class="field-value">Thanh Xuan</div>
                </div>
                <div class="field-row">
                    <div class="field-label">Ward/Commune</div>
                    <div class="field-value">Thuong Dinh</div>
                </div>
                <div class="field-row">
                    <div class="field-label">Postal Code</div>
                    <div class="field-value">100000</div>
                </div>
                <div class="field-row">
                    <div class="field-label">Manager (Warehouse Staff)</div>
                    <div class="field-value">Tran Van B <span class="badge-role">Warehouse Staff</span></div>
                </div>
                <div class="field-row">
                    <div class="field-label">Phone Number</div>
                    <div class="field-value">0987 654 321</div>
                </div>
                <div class="field-row">
                    <div class="field-label">Email</div>
                    <div class="field-value">tranvanb@bmwms.com</div>
                </div>
                <div class="field-row">
                    <div class="field-label">Description</div>
                    <div class="field-value">Main warehouse in Hanoi for storing and distributing goods.</div>
                </div>
            </div>
        </div><!-- /content -->
    </div><!-- /main -->

    <script>
        function toggleDropdown() {
            const menu = document.getElementById('moreMenu');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.dropdown-wrapper')) {
                document.getElementById('moreMenu').style.display = 'none';
            }
        });
        // show dropdown by default so it matches the screenshot
        document.getElementById('moreMenu').style.display = 'block';
    </script>
</body>

</html>