@page
@model BmWms.Web.Pages.Auth.ForgotPasswordModel
@{
    Layout = "_Layout";
    ViewData["NoShell"] = true;
}

<div class="login-page" style="justify-content:center;align-items:center;background:var(--color-bg);">
    <div style="width:100%;max-width:400px;padding:24px;">

        <a href="/Auth/Login" style="display:inline-flex;align-items:center;gap:6px;color:var(--color-text-muted);font-size:13px;text-decoration:none;margin-bottom:28px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
            </svg>
            Quay lại đăng nhập
        </a>

        <div class="wms-card" style="padding:28px 32px;">
            <h1 style="font-size:20px;font-weight:800;margin-bottom:6px;">Quên mật khẩu</h1>
            <p style="color:var(--color-text-muted);font-size:13.5px;margin-bottom:24px;">
                Nhập email đã đăng ký. Chúng tôi sẽ gửi mã OTP 6 chữ số.
            </p>

            <div id="step-email">
                <div id="fp-error" class="toast-wms error" style="display:none;margin-bottom:16px;"></div>
                <div id="fp-info"  class="toast-wms info"  style="display:none;margin-bottom:16px;"></div>

                <div class="wms-field">
                    <label class="wms-label" for="email">Email</label>
                    <input class="wms-input" type="email" id="email" placeholder="email@company.com" autofocus />
                </div>

                <button class="btn-wms-primary" id="btn-send-otp" style="width:100%;justify-content:center;padding:10px;">
                    Gửi mã OTP
                </button>
            </div>

            <!-- Bước 2: nhập OTP + mật khẩu mới (ẩn ban đầu) -->
            <div id="step-reset" style="display:none;">
                <div class="toast-wms success" style="margin-bottom:20px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
                    OTP đã gửi. Kiểm tra hộp thư (hiệu lực 10 phút).
                </div>

                <div id="reset-error" class="toast-wms error" style="display:none;margin-bottom:16px;"></div>

                <div class="wms-field">
                    <label class="wms-label" for="otp">Mã OTP</label>
                    <input class="wms-input" type="text" id="otp" placeholder="123456" maxlength="6"
                           style="letter-spacing:6px;font-size:20px;text-align:center;" />
                </div>

                <div class="wms-field">
                    <label class="wms-label" for="new-password">Mật khẩu mới</label>
                    <input class="wms-input" type="password" id="new-password" placeholder="Tối thiểu 8 ký tự" />
                    <div class="wms-hint">Phải có chữ hoa, chữ thường, số và ký tự đặc biệt.</div>
                </div>

                <button class="btn-wms-primary" id="btn-reset" style="width:100%;justify-content:center;padding:10px;">
                    Đặt lại mật khẩu
                </button>
                <button class="btn-wms-secondary" id="btn-resend" style="width:100%;justify-content:center;margin-top:10px;">
                    Gửi lại mã
                </button>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
(function () {
    let emailValue = '';

    document.getElementById('btn-send-otp').addEventListener('click', sendOtp);
    document.getElementById('btn-reset').addEventListener('click',    doReset);
    document.getElementById('btn-resend').addEventListener('click',   sendOtp);

    async function sendOtp() {
        emailValue = document.getElementById('email')?.value.trim() || emailValue;
        const errEl  = document.getElementById('fp-error');
        const infoEl = document.getElementById('fp-info');
        errEl.style.display = infoEl.style.display = 'none';

        if (!emailValue) { errEl.textContent = 'Vui lòng nhập email.'; errEl.style.display = 'flex'; return; }

        const res  = await fetch('/api/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailValue })
        });

        // API luôn trả Ok để chống email enumeration
        document.getElementById('step-email').style.display = 'none';
        document.getElementById('step-reset').style.display = 'block';
    }

    async function doReset() {
        const otp         = document.getElementById('otp').value.trim();
        const newPassword = document.getElementById('new-password').value;
        const errEl       = document.getElementById('reset-error');
        errEl.style.display = 'none';

        if (!otp || !newPassword) { errEl.textContent = 'Vui lòng điền đầy đủ.'; errEl.style.display = 'flex'; return; }

        const res  = await fetch('/api/auth/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailValue, otp, newPassword })
        });

        const data = await res.json();
        if (res.ok) {
            showToast('Đặt lại mật khẩu thành công! Đang chuyển hướng...', 'success');
            setTimeout(() => window.location.href = '/Auth/Login', 1800);
        } else {
            errEl.textContent  = data.message || 'OTP không đúng hoặc đã hết hạn.';
            errEl.style.display = 'flex';
        }
    }
})();
</script>
}
