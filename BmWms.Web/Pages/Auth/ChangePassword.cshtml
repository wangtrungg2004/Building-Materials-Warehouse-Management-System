@page
@model BmWms.Web.Pages.Auth.ChangePasswordModel
@{
    ViewData["Title"]    = "Đổi mật khẩu";
    ViewData["Subtitle"] = "Cập nhật mật khẩu đăng nhập";
}

<div style="max-width:480px;">
    <div class="wms-card">
        <div class="wms-card-header">
            <h2 class="wms-card-title">Đổi mật khẩu</h2>
        </div>
        <div class="wms-card-body">

            <div id="cp-error"   class="toast-wms error"   style="display:none;margin-bottom:16px;"></div>
            <div id="cp-success" class="toast-wms success" style="display:none;margin-bottom:16px;"></div>

            <div class="wms-field">
                <label class="wms-label" for="current-pw">Mật khẩu hiện tại</label>
                <input class="wms-input" type="password" id="current-pw" placeholder="••••••••" />
            </div>

            <div class="wms-field">
                <label class="wms-label" for="new-pw">Mật khẩu mới</label>
                <input class="wms-input" type="password" id="new-pw" placeholder="••••••••" />
                <div class="wms-hint">Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</div>
            </div>

            <div class="wms-field">
                <label class="wms-label" for="confirm-pw">Xác nhận mật khẩu mới</label>
                <input class="wms-input" type="password" id="confirm-pw" placeholder="••••••••" />
            </div>

            <div style="display:flex;gap:10px;margin-top:4px;">
                <button class="btn-wms-primary" id="btn-save" style="flex:1;justify-content:center;padding:10px;">
                    Lưu thay đổi
                </button>
                <a href="/Dashboard" class="btn-wms-secondary" style="flex:1;justify-content:center;padding:10px;text-align:center;">
                    Huỷ
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('btn-save').addEventListener('click', async () => {
    const currentPassword = document.getElementById('current-pw').value;
    const newPassword     = document.getElementById('new-pw').value;
    const confirmPassword = document.getElementById('confirm-pw').value;
    const errEl           = document.getElementById('cp-error');
    const okEl            = document.getElementById('cp-success');

    errEl.style.display = okEl.style.display = 'none';

    if (!currentPassword || !newPassword || !confirmPassword) {
        errEl.textContent = 'Vui lòng điền đầy đủ tất cả các trường.';
        errEl.style.display = 'flex'; return;
    }

    if (newPassword !== confirmPassword) {
        errEl.textContent = 'Mật khẩu mới và xác nhận không khớp.';
        errEl.style.display = 'flex'; return;
    }

    const res  = await apiFetch('/api/auth/change-password', {
        method: 'POST',
        body: JSON.stringify({ currentPassword, newPassword })
    });

    const data = await res.json();
    if (res.ok) {
        okEl.textContent  = 'Đổi mật khẩu thành công! Đang đăng xuất để đăng nhập lại...';
        okEl.style.display = 'flex';
        setTimeout(() => { Auth.clear(); redirectToLogin(); }, 2000);
    } else {
        errEl.textContent  = data.message || 'Đổi mật khẩu thất bại.';
        errEl.style.display = 'flex';
    }
});
</script>
}
